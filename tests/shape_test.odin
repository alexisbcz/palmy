package palmy_tests

import "core:strings"
import "core:testing"
import "core:unicode/utf8"
import p "../palmy"

// ---------------------------------------------------------------------------
// Arabic shaping (palmy/shape.odin)
//
// Three kinds of test here, in increasing order of how much they would catch:
//
//   1. hand-written assertions on exact codepoints, which say what the module
//      is supposed to produce and are readable without a shaper in hand;
//   2. the harfbuzz oracle in arabic_oracle.odin -- 88 corpus cases and 400
//      random strings, each carrying the positional form harfbuzz's GSUB chose
//      per input character. Generated by tools/arabic/hb-oracle.py, which is
//      also where the note on what can and cannot be compared lives;
//   3. a fuzz loop over several thousand generated strings asserting the
//      invariants: valid codepoints, nothing lost, and idempotence.
// ---------------------------------------------------------------------------

// Letters, as runes, so the test bodies read as Arabic rather than as hex.
ALEF :: rune(0x0627)
ALEF_MADDA :: rune(0x0622)
BEH :: rune(0x0628)
TEH :: rune(0x062a)
DAL :: rune(0x062f)
REH :: rune(0x0631)
SEEN :: rune(0x0633)
LAM :: rune(0x0644)
MEEM :: rune(0x0645)
HEH :: rune(0x0647)
YEH :: rune(0x064a)
FATHA :: rune(0x064e)
SHADDA :: rune(0x0651)
TATWEEL :: rune(0x0640)
ZWJ :: rune(0x200d)
ZWNJ :: rune(0x200c)
PEH :: rune(0x067e)

@(private = "file")
shaped :: proc(s: string) -> string {
	return p.shape_arabic(s, p.DEFAULT_SHAPE_OPTIONS, context.temp_allocator)
}

@(private = "file")
cps :: proc(s: string, allocator := context.temp_allocator) -> []rune {
	return utf8.string_to_runes(s, allocator)
}

@(private = "file")
expect_cps :: proc(t: ^testing.T, got: string, want: []rune, what: string) {
	have := cps(got)
	ok := len(have) == len(want)
	if ok {
		for r, i in have {
			if r != want[i] {
				ok = false
				break
			}
		}
	}
	if !ok {
		b := strings.builder_make(context.temp_allocator)
		strings.write_string(&b, what)
		strings.write_string(&b, ": got")
		for r in have {
			strings.write_string(&b, " ")
			strings.write_string(&b, fmt_hex(r))
		}
		strings.write_string(&b, ", want")
		for r in want {
			strings.write_string(&b, " ")
			strings.write_string(&b, fmt_hex(r))
		}
		testing.expect(t, false, strings.to_string(b))
	}
}

@(private = "file")
fmt_hex :: proc(r: rune) -> string {
	digits := "0123456789abcdef"
	b := strings.builder_make(context.temp_allocator)
	strings.write_string(&b, "U+")
	v := u32(r)
	for shift := 12; shift >= 0; shift -= 4 {
		strings.write_byte(&b, digits[(v >> uint(shift)) & 0xf])
	}
	return strings.to_string(b)
}

// ---------------------------------------------------------------------------
// 1. The joining data
// ---------------------------------------------------------------------------

@(test)
test_arabic_joining_types :: proc(t: ^testing.T) {
	// Dual-joining: the letters that take all four forms.
	for r in ([]rune{BEH, TEH, SEEN, LAM, MEEM, HEH, YEH, PEH}) {
		testing.expect_value(t, p.arabic_joining_type(r), p.Joining_Type.Dual)
	}
	// Right-joining: joins what comes before it and nothing after.
	for r in ([]rune{ALEF, ALEF_MADDA, DAL, REH, 0x0632, 0x0648, 0x0629, 0x0698}) {
		testing.expect_value(t, p.arabic_joining_type(r), p.Joining_Type.Right)
	}
	// Join-causing: joins both sides and has no shape of its own.
	testing.expect_value(t, p.arabic_joining_type(TATWEEL), p.Joining_Type.Causing)
	testing.expect_value(t, p.arabic_joining_type(ZWJ), p.Joining_Type.Causing)
	// Transparent: the harakat, and every other combining mark or format
	// character, which joining looks straight through.
	for r in ([]rune{FATHA, SHADDA, 0x064b, 0x0650, 0x0652, 0x0670, 0x0610, 0xfe0f}) {
		testing.expect_value(t, p.arabic_joining_type(r), p.Joining_Type.Transparent)
	}
	// Non-joining: everything that breaks a run.
	for r in ([]rune{' ', '\t', '\n', 'a', 'Z', '0', '9', ',', 0x0621, ZWNJ, 0x0660, 0x4e2d, 0x1f600}) {
		testing.expect_value(t, p.arabic_joining_type(r), p.Joining_Type.Non_Joining)
	}
	// A presentation form is non-joining and not shapable, which is what makes
	// shaping idempotent.
	for r in ([]rune{0xfe91, 0xfeb4, 0xfefb, 0xfe8d}) {
		testing.expect_value(t, p.arabic_joining_type(r), p.Joining_Type.Non_Joining)
		testing.expect(t, !p.arabic_shapable(r), "a presentation form must not be shapable")
	}
	testing.expect(t, p.arabic_shapable(BEH))
	testing.expect(t, p.arabic_shapable(PEH), "Persian peh comes from Presentation Forms-A")
	testing.expect(t, !p.arabic_shapable('a'))
	testing.expect(t, !p.arabic_shapable(FATHA), "a mark has no presentation form")
	testing.expect(t, !p.arabic_shapable(TATWEEL), "tatweel has no shape of its own")
}

@(test)
test_arabic_presentation_table :: proc(t: ^testing.T) {
	// Spot-check the generated table against Unicode's own block layout: beh's
	// four forms are U+FE8F..U+FE92, in isolated/final/initial/medial order.
	cp, ok := p.arabic_presentation(BEH, .Isolated)
	testing.expect(t, ok)
	testing.expect_value(t, cp, rune(0xfe8f))
	cp, _ = p.arabic_presentation(BEH, .Final)
	testing.expect_value(t, cp, rune(0xfe90))
	cp, _ = p.arabic_presentation(BEH, .Initial)
	testing.expect_value(t, cp, rune(0xfe91))
	cp, _ = p.arabic_presentation(BEH, .Medial)
	testing.expect_value(t, cp, rune(0xfe92))

	// A right-joining letter has no initial or medial form, so the request
	// falls back towards the isolated one rather than inventing a codepoint.
	cp, ok = p.arabic_presentation(ALEF, .Medial)
	testing.expect(t, ok)
	testing.expect(t, cp == rune(0xfe8e), "alef medial falls back to final")
	cp, _ = p.arabic_presentation(ALEF, .Initial)
	testing.expect(t, cp == rune(0xfe8d), "alef initial falls back to isolated")

	// Alef maksura is dual-joining, but only Forms-A encodes its initial and
	// medial shapes -- which is what the forms_a option is about.
	cp, ok = p.arabic_presentation(0x0649, .Medial)
	testing.expect_value(t, cp, rune(0xfbe9))
	cp, ok = p.arabic_presentation(0x0649, .Medial, p.Shape_Options{lam_alef = true, forms_a = false})
	testing.expect(t, ok)
	testing.expect(t, cp == rune(0xfef0), "without Forms-A it falls back to the final form")

	// A letter Unicode encodes no form for is reported, not guessed at.
	_, ok = p.arabic_presentation('a', .Initial)
	testing.expect(t, !ok)
	_, ok = p.arabic_presentation(0x08a0, .Initial)
	testing.expect(t, !ok, "Arabic Extended-A has no presentation forms")
}

// ---------------------------------------------------------------------------
// 2. The positional forms
// ---------------------------------------------------------------------------

@(test)
test_arabic_four_positions :: proc(t: ^testing.T) {
	// One dual-joining letter, in all four positions.
	expect_cps(t, shaped("ب"), {BEH}, "alone: the base codepoint is the isolated shape")
	expect_cps(t, shaped("بب"), {0xfe91, 0xfe90}, "two: initial then final")
	expect_cps(t, shaped("ببب"), {0xfe91, 0xfe92, 0xfe90}, "three: the middle is medial")
	expect_cps(
		t,
		shaped("بببب"),
		{0xfe91, 0xfe92, 0xfe92, 0xfe90},
		"four: two medials",
	)

	// A real word: beh initial, seen medial, meem final.
	expect_cps(t, shaped("بسم"), {0xfe91, 0xfeb4, 0xfee2}, "bism")
	// alef isolated, lam initial, lam medial, heh final.
	expect_cps(t, shaped("الله"), {ALEF, 0xfedf, 0xfee0, 0xfeea}, "allah")
}

@(test)
test_arabic_right_joining_breaks_the_group :: proc(t: ^testing.T) {
	// This is the rule that decides whether Arabic looks right. A right-joining
	// letter takes a final form itself but cannot join forward, so the letter
	// after it starts a fresh group however many letters follow.
	expect_cps(t, shaped("بابا"), {0xfe91, 0xfe8e, 0xfe91, 0xfe8e}, "baba")
	expect_cps(
		t,
		shaped("كتاب"),
		{0xfedb, 0xfe98, 0xfe8e, BEH},
		"kitab: the beh after the alef is isolated, not final",
	)
	// Two and three right-joining letters in a row never join at all.
	expect_cps(t, shaped("دد"), {DAL, DAL}, "dal dal")
	expect_cps(t, shaped("ددد"), {DAL, DAL, DAL}, "dal dal dal")
	// ... but a dual-joining letter before one still joins forward to it.
	expect_cps(t, shaped("بد"), {0xfe91, 0xfeaa}, "beh dal: initial then final")
	expect_cps(t, shaped("برب"), {0xfe91, 0xfeae, BEH}, "beh reh beh")
}

@(test)
test_arabic_transparent_marks_are_skipped :: proc(t: ^testing.T) {
	// A harakat between two letters is invisible to joining: the beh still
	// goes initial and the yeh still goes medial, and the mark itself survives
	// in the output, unchanged and in place.
	expect_cps(
		t,
		shaped("بَيت"),
		{0xfe91, FATHA, 0xfef4, 0xfe96},
		"bayt with a fatha",
	)
	// Several marks in a row, including a shadda, still do not break it.
	expect_cps(
		t,
		shaped("بَّيت"),
		{0xfe91, FATHA, SHADDA, 0xfef4, 0xfe96},
		"two marks between letters",
	)
	// A string of nothing but marks is passed through untouched.
	expect_cps(t, shaped("َُِ"), {0x064e, 0x064f, 0x0650}, "marks only")
	// A mark at the start, with nothing before it to join.
	expect_cps(t, shaped("َبب"), {FATHA, 0xfe91, 0xfe90}, "leading mark")
}

@(test)
test_arabic_joiners_and_tatweel :: proc(t: ^testing.T) {
	// Tatweel is join-causing: it joins both neighbours and keeps its own
	// codepoint, so the letters either side go medial as if it were a letter.
	expect_cps(t, shaped("بـب"), {0xfe91, TATWEEL, 0xfe90}, "beh tatweel beh")
	expect_cps(t, shaped("بـ"), {0xfe91, TATWEEL}, "a trailing tatweel still joins")
	// ZWJ does the same without drawing: it is how an isolated letter is shown
	// in its initial or final shape.
	expect_cps(t, shaped("ب‍"), {0xfe91, ZWJ}, "beh ZWJ gives the initial form")
	expect_cps(t, shaped("‍ب"), {ZWJ, 0xfe90}, "ZWJ beh gives the final form")
	// ZWNJ is non-joining and breaks the run, which is exactly what Persian
	// uses it for.
	expect_cps(t, shaped("ب‌ب"), {BEH, ZWNJ, BEH}, "ZWNJ breaks the join")
}

@(test)
test_arabic_lam_alef :: proc(t: ^testing.T) {
	// The required ligature, in its isolated form: one glyph for two letters.
	expect_cps(t, shaped("لا"), {0xfefb}, "lam alef")
	expect_cps(t, shaped("لآ"), {0xfef5}, "lam alef madda")
	expect_cps(t, shaped("لأ"), {0xfef7}, "lam alef hamza above")
	expect_cps(t, shaped("لإ"), {0xfef9}, "lam alef hamza below")
	// Joined to what precedes it, the final form.
	expect_cps(t, shaped("سلا"), {0xfeb3, 0xfefc}, "sal-la: the final ligature")
	expect_cps(t, shaped("سلام"), {0xfeb3, 0xfefc, MEEM}, "salam")
	// The alef ends the group, so the letter after it is isolated.
	expect_cps(t, shaped("لام"), {0xfefb, MEEM}, "lam alef meem")
	// lam lam alef: the first lam joins the ligature.
	expect_cps(t, shaped("للا"), {0xfedf, 0xfefc}, "lam lam alef")
	// A harakat standing between lam and alef does not prevent the required
	// ligature; it is emitted straight after it so no codepoint is lost.
	expect_cps(t, shaped("لَا"), {0xfefb, FATHA}, "lam fatha alef")
	expect_cps(t, shaped("سلَام"), {0xfeb3, 0xfefc, FATHA, MEEM}, "sal-la with a fatha")
	// lam followed by something that is not an alef is just a lam.
	expect_cps(t, shaped("لب"), {0xfedf, 0xfe90}, "lam beh")
	expect_cps(t, shaped("لو"), {0xfedf, 0xfeee}, "lam waw")
	// alef lam is not a ligature either: order matters.
	expect_cps(t, shaped("ال"), {ALEF, LAM}, "alef lam")

	// With the ligature turned off the two letters stand, correctly joined.
	off := p.Shape_Options{lam_alef = false, forms_a = true}
	s := p.shape_arabic("سلا", off, context.temp_allocator)
	expect_cps(t, s, {0xfeb3, 0xfee0, 0xfe8e}, "no ligature: lam medial, alef final")
}

@(test)
test_arabic_runs_are_broken_by_everything_else :: proc(t: ^testing.T) {
	// A space, a digit, a Latin letter and punctuation all end a joining run.
	expect_cps(t, shaped("بب بب"), {0xfe91, 0xfe90, ' ', 0xfe91, 0xfe90}, "space")
	expect_cps(
		t,
		shaped("بب" + "12" + "بب"),
		{0xfe91, 0xfe90, '1', '2', 0xfe91, 0xfe90},
		"digits",
	)
	expect_cps(t, shaped("aببz"), {'a', 0xfe91, 0xfe90, 'z'}, "Latin")
	expect_cps(t, shaped("بب-ب"), {0xfe91, 0xfe90, '-', BEH}, "a hyphen")
	// Arabic-Indic digits are non-joining too, which is easy to get wrong
	// because they are in the Arabic block.
	expect_cps(t, shaped("ب١ب"), {BEH, 0x0661, BEH}, "Arabic-Indic digits break it")

	// Text with no Arabic in it is not touched, and is reported as not needing
	// to be.
	for s in ([]string{"", " ", "Hello, world", "123", "中文", "\U0001f600", "שלום"}) {
		testing.expect(t, !p.needs_arabic_shaping(s), "must not claim to need shaping")
		out := shaped(s)
		testing.expect_value(t, out, s)
	}
	testing.expect(t, p.needs_arabic_shaping("ب"))
	testing.expect(t, p.needs_arabic_shaping("hello مرحبا"))
	testing.expect(
		t,
		!p.needs_arabic_shaping("١٢٣"),
		"digits alone are nothing to shape",
	)
	testing.expect(
		t,
		!p.needs_arabic_shaping("ﺑﺴﻢ"),
		"already-shaped text needs nothing",
	)
}

@(test)
test_arabic_persian_and_urdu :: proc(t: ^testing.T) {
	// The Persian and Urdu letters live in Presentation Forms-A. peh is
	// dual-joining, jeh is right-joining.
	expect_cps(t, shaped("پپ"), {0xfb58, 0xfb57}, "peh peh")
	expect_cps(t, shaped("پارسی"), {0xfb58, 0xfe8e, REH, 0xfeb3, 0xfbfd}, "parsi: seen goes initial before the farsi yeh")
	expect_cps(t, shaped("گفتگو"), {0xfb94, 0xfed4, 0xfe98, 0xfb95, 0xfeee}, "goftogu: the second gaf is medial")
	expect_cps(t, shaped("ژا"), {0x0698, ALEF}, "jeh is right-joining")

	// With Forms-A declined the Persian letters keep their base codepoint
	// rather than render as tofu in a font that has no Forms-A coverage.
	off := p.Shape_Options{lam_alef = true, forms_a = false}
	s := p.shape_arabic("پپ", off, context.temp_allocator)
	expect_cps(t, s, {PEH, PEH}, "no Forms-A: the base letters stand")
	// A Forms-B letter is unaffected by that option.
	s = p.shape_arabic("بب", off, context.temp_allocator)
	expect_cps(t, s, {0xfe91, 0xfe90}, "Forms-B is always available")
}

@(test)
test_arabic_source_offsets :: proc(t: ^testing.T) {
	// The mapping back into the source string, which a caret needs.
	runes := p.shape_arabic_runes("سلَام")
	defer delete(runes)
	testing.expect_value(t, len(runes), 4)

	testing.expect_value(t, runes[0].cp, rune(0xfeb3)) // seen, initial
	testing.expect_value(t, runes[0].form, p.Shape_Form.Initial)
	testing.expect_value(t, runes[0].src, 0)
	testing.expect_value(t, runes[0].size, 2)
	testing.expect(t, runes[0].shaped)

	testing.expect_value(t, runes[1].cp, rune(0xfefc)) // the lam-alef ligature
	testing.expect(t, runes[1].lig)
	testing.expect_value(t, runes[1].form, p.Shape_Form.Final)
	testing.expect_value(t, runes[1].src, 2)
	testing.expect(t, runes[1].size == 6, "the ligature spans lam, fatha and alef")

	testing.expect_value(t, runes[2].cp, FATHA) // the mark from inside the span
	testing.expect_value(t, runes[2].src, 4)
	testing.expect(t, !runes[2].shaped)

	testing.expect_value(t, runes[3].cp, MEEM)
	testing.expect_value(t, runes[3].src, 8)
	testing.expect_value(t, runes[3].form, p.Shape_Form.Isolated)
}

// ---------------------------------------------------------------------------
// 3. The harfbuzz oracle
// ---------------------------------------------------------------------------

// oracle_forms is the per-character form code for palmy's own shaping, in the
// same encoding tools/arabic/hb-oracle.py reads out of harfbuzz's glyph names.
@(private = "file")
oracle_forms :: proc(s: string, allocator := context.temp_allocator) -> string {
	n := utf8.rune_count_in_string(s)
	code := make([]u8, n, allocator)
	at := make([]int, n, allocator) // byte offset of each input rune
	{
		i, k := 0, 0
		for i < len(s) {
			_, w := utf8.decode_rune_in_string(s[i:])
			code[k], at[k] = '.', i
			i += w
			k += 1
		}
	}
	index_of :: proc(at: []int, off: int) -> int {
		for o, i in at {
			if o == off {
				return i
			}
		}
		return -1
	}

	runes := p.shape_arabic_runes(s, p.DEFAULT_SHAPE_OPTIONS, allocator)
	for sr in runes {
		k := index_of(at, sr.src)
		if k < 0 {
			continue
		}
		if sr.lig {
			code[k] = sr.form == .Final ? 'L' : 'J'
			// The alef is the last input rune inside the ligature's span.
			last := k
			for j in k ..< len(at) {
				if at[j] < sr.src + sr.size {
					last = j
				}
			}
			code[last] = '~'
			continue
		}
		src, _ := utf8.decode_rune_in_string(s[sr.src:])
		if !p.arabic_shapable(src) {
			continue
		}
		switch sr.form {
		case .Isolated:
			code[k] = 'X'
		case .Final:
			code[k] = 'F'
		case .Initial:
			code[k] = 'I'
		case .Medial:
			code[k] = 'M'
		}
	}
	return string(code)
}

@(test)
test_arabic_against_harfbuzz_corpus :: proc(t: ^testing.T) {
	// Every case in tools/arabic/corpus.txt: single letters of each joining
	// type, the four positions, lam-alef alone and mid-word, harakat between
	// joining letters, mixed Arabic and Latin, Arabic with digits, the empty
	// string, text that is nothing but marks, Persian, Urdu, and strings that
	// are already shaped.
	for c in ARABIC_ORACLE {
		got := oracle_forms(c.text)
		testing.expectf(
			t,
			got == c.forms,
			"shaping %q: palmy says %q, harfbuzz says %q",
			c.text,
			got,
			c.forms,
		)
	}
}

@(test)
test_arabic_against_harfbuzz_fuzz :: proc(t: ^testing.T) {
	// 400 random strings over the Arabic alphabet, the harakat, the joiners,
	// the Persian letters, digits and Latin, with harfbuzz's answer for each
	// frozen into the generated table.
	for c in ARABIC_ORACLE_FUZZ {
		got := oracle_forms(c.text)
		testing.expectf(
			t,
			got == c.forms,
			"shaping %q: palmy says %q, harfbuzz says %q",
			c.text,
			got,
			c.forms,
		)
	}
}

// ---------------------------------------------------------------------------
// 4. Invariants, under fuzz
// ---------------------------------------------------------------------------

@(private = "file")
FUZZ_ALPHABET := [?]rune {
	// the basic alphabet, every joining type represented
	0x0621, 0x0622, 0x0623, 0x0625, 0x0626, 0x0627, 0x0628, 0x0629,
	0x062a, 0x062c, 0x062d, 0x062f, 0x0631, 0x0632, 0x0633, 0x0634,
	0x0635, 0x0637, 0x0639, 0x0641, 0x0642, 0x0643, 0x0644, 0x0645,
	0x0646, 0x0647, 0x0648, 0x0649, 0x064a,
	// harakat and a superscript alef, all transparent
	0x064b, 0x064e, 0x064f, 0x0650, 0x0651, 0x0652, 0x0670,
	// tatweel, ZWNJ, ZWJ
	0x0640, 0x200c, 0x200d,
	// Persian and Urdu, which come from Forms-A
	0x067e, 0x0686, 0x0698, 0x06a9, 0x06af, 0x06cc, 0x0679,
	// the run breakers
	' ', ',', '.', '0', '7', 'a', 'z', 'A', 0x0661, 0x0669,
	// letters with no presentation form at all, which must pass through
	0x0620, 0x063b, 0x08a0,
	// an already-shaped letter and a ligature, which must not shape again
	0xfe91, 0xfeb4, 0xfefb,
	// and some things from outside the script entirely
	0x4e2d, 0x1f600, 0x05d0,
}

@(test)
test_arabic_fuzz_invariants :: proc(t: ^testing.T) {
	// A fixed xorshift, so a failure is reproducible without a seed to carry.
	state: u64 = 0x9e3779b97f4a7c15
	next :: proc(s: ^u64) -> u64 {
		s^ ~= s^ << 13
		s^ ~= s^ >> 7
		s^ ~= s^ << 17
		return s^
	}

	ROUNDS :: 3000
	for round in 0 ..< ROUNDS {
		b := strings.builder_make(context.temp_allocator)
		n := int(next(&state) % 14)
		for _ in 0 ..< n {
			strings.write_rune(&b, FUZZ_ALPHABET[next(&state) % u64(len(FUZZ_ALPHABET))])
		}
		src := strings.to_string(b)

		runes := p.shape_arabic_runes(src, p.DEFAULT_SHAPE_OPTIONS, context.temp_allocator)
		out := p.shape_arabic(src, p.DEFAULT_SHAPE_OPTIONS, context.temp_allocator)

		// Every codepoint out is a real codepoint, and it is either one that
		// came in or one of Unicode's presentation forms. Nothing else can be
		// produced, so no run can end up with a glyph the font cannot name.
		ligs := 0
		for sr in runes {
			testing.expectf(
				t,
				sr.cp > 0 && sr.cp <= 0x10ffff && !(sr.cp >= 0xd800 && sr.cp <= 0xdfff),
				"round %d: %q produced the invalid codepoint %d",
				round,
				src,
				i32(sr.cp),
			)
			if sr.shaped {
				testing.expectf(
					t,
					(sr.cp >= 0xfb50 && sr.cp <= 0xfdff) || (sr.cp >= 0xfe70 && sr.cp <= 0xfefc),
					"round %d: %q produced %d, which is not a presentation form",
					round,
					src,
					i32(sr.cp),
				)
			} else {
				at, _ := utf8.decode_rune_in_string(src[sr.src:])
				testing.expectf(
					t,
					at == sr.cp,
					"round %d: %q changed a codepoint while reporting it unshaped",
					round,
					src,
				)
			}
			testing.expectf(
				t,
				sr.src >= 0 && sr.src + sr.size <= len(src) && sr.size > 0,
				"round %d: %q produced a source span outside the string",
				round,
				src,
			)
			if sr.lig {
				ligs += 1
			}
		}

		// Nothing is lost and nothing is invented: one output rune per input
		// rune, less one for each ligature that merged two letters.
		testing.expectf(
			t,
			utf8.rune_count_in_string(out) == utf8.rune_count_in_string(src) - ligs,
			"round %d: %q lost or gained a rune",
			round,
			src,
		)
		testing.expectf(
			t,
			utf8.valid_string(out),
			"round %d: %q produced invalid UTF-8",
			round,
			src,
		)

		// Idempotence. Shaping shaped text must not shape it again, which is
		// the property that makes it safe to run on text of unknown provenance.
		again := p.shape_arabic(out, p.DEFAULT_SHAPE_OPTIONS, context.temp_allocator)
		testing.expectf(t, again == out, "round %d: %q is not idempotent", round, src)

		// And with the options off, still no crash and still idempotent.
		bare := p.Shape_Options{}
		plain := p.shape_arabic(src, bare, context.temp_allocator)
		testing.expectf(
			t,
			plain == p.shape_arabic(plain, bare, context.temp_allocator),
			"round %d: %q is not idempotent with the options off",
			round,
			src,
		)
	}
}

@(test)
test_arabic_idempotent_on_the_corpus :: proc(t: ^testing.T) {
	for c in ARABIC_ORACLE {
		once := shaped(c.text)
		twice := shaped(once)
		testing.expectf(t, once == twice, "shaping %q twice changed it", c.text)
	}
	for c in ARABIC_ORACLE_FUZZ {
		once := shaped(c.text)
		testing.expectf(t, once == shaped(once), "shaping %q twice changed it", c.text)
	}
}

// ---------------------------------------------------------------------------
// 5. What it looks like
//
// The module's whole purpose is visual, so these assert on rendered pixels.
// tools/arabic/shot writes the same lines out as PNGs to look at.
// ---------------------------------------------------------------------------

@(private = "file")
ink_columns :: proc(off: ^p.Offscreen) -> (first, last, count: int) {
	first, last = -1, -1
	for x in 0 ..< off.width {
		has := false
		for y in 0 ..< off.height {
			c := p.offscreen_pixel(off, x, y)
			if c.r > 40 || c.g > 40 || c.b > 40 {
				has = true
				break
			}
		}
		if has {
			if first < 0 {
				first = x
			}
			last = x
			count += 1
		}
	}
	return
}

@(test)
test_arabic_renders_narrower_when_shaped :: proc(t: ^testing.T) {
	off := p.offscreen_create(420, 90, 1, "w-full h-full bg-black text-white")
	defer p.offscreen_destroy(off)

	// The same word, shaped and not. Joined letters overlap where isolated
	// ones cannot, so the shaped line is shorter -- and it has to put ink on
	// the canvas, because a row of boxes or a row of nothing would also pass
	// a width assertion.
	word := "العربية" // al-arabiya
	shaped_word := p.shape_arabic(word, p.DEFAULT_SHAPE_OPTIONS, context.allocator)
	defer delete(shaped_word)

	ui := p.offscreen_begin(off)
	p.text(ui, word, "text-3xl")
	p.offscreen_end(off)
	_, _, unshaped_ink := ink_columns(off)
	unshaped_w := p.text_width(&off.fonts, word, 30)

	ui = p.offscreen_begin(off)
	p.text(ui, shaped_word, "text-3xl")
	p.offscreen_end(off)
	first, last, shaped_ink := ink_columns(off)
	shaped_w := p.text_width(&off.fonts, shaped_word, 30)

	testing.expect(t, shaped_ink > 20, "the shaped line must actually draw something")
	testing.expect(t, unshaped_ink > 20, "so must the unshaped one")
	testing.expectf(
		t,
		shaped_w < unshaped_w,
		"shaped %.1fpx should be narrower than unshaped %.1fpx",
		shaped_w,
		unshaped_w,
	)
	testing.expect(t, first >= 0 && last < off.width, "the line must fit the canvas")

	// Every codepoint in the shaped word must resolve to a real glyph, or the
	// line would be drawing tofu where it used to draw letters. A missing glyph
	// in these faces is a 0-advance notdef box; comparing the measured width
	// against the sum of the per-rune widths catches a dropped rune instead.
	sum := f32(0)
	for r in shaped_word {
		b := strings.builder_make(context.temp_allocator)
		strings.write_rune(&b, r)
		sum += p.text_width(&off.fonts, strings.to_string(b), 30)
	}
	testing.expectf(t, sum > shaped_w * 0.9, "the shaped runes measure %.1f against %.1f", sum, shaped_w)
}

@(test)
test_arabic_lam_alef_renders_as_one_glyph :: proc(t: ^testing.T) {
	off := p.offscreen_create(300, 80, 1, "w-full h-full bg-black text-white")
	defer p.offscreen_destroy(off)

	lig := p.shape_arabic("لا", p.DEFAULT_SHAPE_OPTIONS, context.allocator)
	defer delete(lig)

	// One ligature, so one rune and one glyph, and it is drawn.
	testing.expect_value(t, utf8.rune_count_in_string(lig), 1)

	ui := p.offscreen_begin(off)
	p.text(ui, lig, "text-3xl")
	p.offscreen_end(off)
	_, _, ink := ink_columns(off)
	testing.expect(t, ink > 8, "the lam-alef ligature must draw")

	// And it is narrower than the two letters side by side.
	testing.expect(
		t,
		p.text_width(&off.fonts, lig, 30) < p.text_width(&off.fonts, "لا", 30),
		"the ligature should be narrower than lam plus alef",
	)
}

@(test)
test_arabic_mixed_line_leaves_latin_alone :: proc(t: ^testing.T) {
	off := p.offscreen_create(480, 80, 1, "w-full h-full bg-black text-white")
	defer p.offscreen_destroy(off)

	// A mixed line: the Latin half must render exactly as it did before, so
	// shaping cannot have disturbed it. Same pixels, measured.
	latin := "Hello world"
	ui := p.offscreen_begin(off)
	p.text(ui, latin, "text-2xl")
	p.offscreen_end(off)
	a_first, a_last, a_ink := ink_columns(off)

	mixed := p.shape_arabic("Hello world", p.DEFAULT_SHAPE_OPTIONS, context.allocator)
	defer delete(mixed)
	testing.expect_value(t, mixed, latin)

	ui = p.offscreen_begin(off)
	p.text(ui, mixed, "text-2xl")
	p.offscreen_end(off)
	b_first, b_last, b_ink := ink_columns(off)

	testing.expect_value(t, b_first, a_first)
	testing.expect_value(t, b_last, a_last)
	testing.expect_value(t, b_ink, a_ink)
}
