# Palmy login screen (apps/greeter) — Spanish.
# Format: distro/locale/README.md. Installed as
# /usr/share/palm/locale/es/greeter.msg.
language = es
name     = Español
english  = Spanish
plural   = n != 1

# --- the card ---------------------------------------------------------------
msgid "Sign in"
msgstr "Iniciar sesión"

msgid "Authenticating"
msgstr "Autenticando"

msgid "Session ready"
msgstr "Sesión lista"

msgid "Signed in"
msgstr "Sesión iniciada"

msgid "Password"
msgstr "Contraseña"

msgid "Answer"
msgstr "Respuesta"

msgid "Enter to sign in · Tab to move · Esc to clear"
msgstr "Intro para entrar · Tab para moverse · Esc para borrar"

msgid "%d account"
msgid_plural "%d accounts"
msgstr[0] "%d cuenta"
msgstr[1] "%d cuentas"

msgid "%d session"
msgid_plural "%d sessions"
msgstr[0] "%d sesión"
msgstr[1] "%d sesiones"

msgid "no local accounts"
msgstr "no hay cuentas locales"

msgid "no sessions found"
msgstr "no se encontraron sesiones"

# --- errors and notices -----------------------------------------------------
msgid "Authentication failed"
msgstr "Error de autenticación"

msgid "Authentication failure"
msgstr "Error de autenticación"

msgid "The password was not accepted."
msgstr "La contraseña no fue aceptada."

msgid "greetd error"
msgstr "Error de greetd"

msgid "greetd accepted the session; it starts as soon as the greeter exits"
msgstr "greetd aceptó la sesión; empieza en cuanto se cierre la pantalla de inicio"

msgid "not connected to greetd at %s"
msgstr "sin conexión con greetd en %s"

msgid "there is no account to log in to"
msgstr "no hay ninguna cuenta con la que entrar"

msgid "%s is a --demo-users placeholder, not a real account; it is never sent to greetd"
msgstr "%s es un ejemplo de --demo-users, no una cuenta real; nunca se envía a greetd"

msgid "greetd sent an empty reply"
msgstr "greetd envió una respuesta vacía"

msgid "greetd reported an error"
msgstr "greetd informó de un error"

msgid "no greetd on %s"
msgstr "no hay greetd en %s"

msgid "MOCK greetd"
msgstr "greetd SIMULADO"

msgid "greetd IPC · %s  (F2 hides this)"
msgstr "IPC de greetd · %s  (F2 lo oculta)"

msgid "no socket"
msgstr "sin socket"

msgid "nothing sent yet"
msgstr "aún no se ha enviado nada"

# --- power ------------------------------------------------------------------
msgid "Suspend"
msgstr "Suspender"

msgid "Restart"
msgstr "Reiniciar"

msgid "Shut Down"
msgstr "Apagar"

msgid "Shutting down…"
msgstr "Apagando…"

msgid "Restarting…"
msgstr "Reiniciando…"

msgid "power: would run `%s` (stub — nothing executed)"
msgstr "energía: ejecutaría `%s` (simulación — no se ejecuta nada)"

msgid "%s is not available on this machine"
msgstr "%s no está disponible en este equipo"

msgid "power: palm-login did not answer"
msgstr "energía: palm-login no respondió"

msgid "power: %s"
msgstr "energía: %s"

msgid "refused"
msgstr "rechazado"

# --- the date ---------------------------------------------------------------
# Arguments: weekday, day of the month, month, year (Odin indices start at 0).
msgid "%[0]s, %[1]d %[2]s %[3]d"
msgstr "%[0]s, %[1]d de %[2]s de %[3]d"

