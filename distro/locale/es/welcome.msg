msgstr "Idioma"

msgid "Appearance"
msgstr "Apariencia"

msgid "Dark"
msgstr "Oscuro"

msgid "Light"
msgstr "Claro"

msgid "Applies to this window now, and to every app from your next login."
msgstr "Se aplica ya a esta ventana, y a todas las aplicaciones desde tu próximo inicio de sesión."

