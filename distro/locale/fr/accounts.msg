# Palmframe Accounts (apps/accounts) — French.
# Format: distro/locale/README.md. Belongs in distro/locale/fr/accounts.msg,
# installed as /usr/share/palm/locale/fr/accounts.msg; it lives beside the app
# until the locale owner moves it. Render with:
#   PALM_LOCALE_DIR=apps/accounts/locale accounts shots DIR --lang fr
language = fr
name     = Français
english  = French
plural   = n > 1

# --- signed out --------------------------------------------------------------
msgid "Account"
msgstr "Compte"

msgid "One account. Every identity you are."
msgstr "Un seul compte. Toutes vos identités."

msgid "Work, personal, the public face, the side project: each with its own mail, files and assistant scope. Switching is one step, and nothing crosses between them unless you say so."
msgstr "Le travail, la vie privée, la figure publique, le projet du soir : chacun avec son courrier, ses fichiers et le périmètre de son assistant. On passe de l'une à l'autre en un geste, et rien ne circule entre elles sans votre accord."

msgid "Separation is enforced by the database, row by row, not by which window is open. An assistant given one identity cannot read another's mail."
msgstr "La séparation est garantie par la base de données, ligne par ligne, et non par la fenêtre ouverte. Un assistant chargé d'une identité ne peut pas lire le courrier d'une autre."

msgid "Sign in"
msgstr "Se connecter"

msgid "Create account"
msgstr "Créer un compte"

msgid "Create your account"
msgstr "Créez votre compte"

msgid "Use the email and password of your Palmframe account."
msgstr "Utilisez l'adresse et le mot de passe de votre compte Palmframe."

msgid "Your first identity is created with it. You can add the others later."
msgstr "Votre première identité est créée en même temps. Vous ajouterez les autres ensuite."

msgid "Your name, as this identity"
msgstr "Votre nom, pour cette identité"

msgid "Email"
msgstr "Adresse e-mail"

msgid "Password"
msgstr "Mot de passe"

msgid "At least 8 characters"
msgstr "Au moins 8 caractères"

msgid "Handle"
msgstr "Identifiant"

msgid "Also your mail address. It is permanent; the name above is not."
msgstr "C'est aussi votre adresse de courrier. Il est définitif ; le nom ci-dessus ne l'est pas."

