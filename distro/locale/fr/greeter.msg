# Palmy login screen (apps/greeter) — French.
# Format: distro/locale/README.md. Installed as
# /usr/share/palm/locale/fr/greeter.msg.
language = fr
name     = Français
english  = French
plural   = n > 1

# --- the card ---------------------------------------------------------------
msgid "Sign in"
msgstr "Se connecter"

msgid "Authenticating"
msgstr "Authentification"

msgid "Session ready"
msgstr "Session prête"

msgid "Signed in"
msgstr "Connecté"

msgid "Password"
msgstr "Mot de passe"

msgid "Answer"
msgstr "Réponse"

msgid "Enter to sign in · Tab to move · Esc to clear"
msgstr "Entrée pour se connecter · Tab pour changer · Échap pour effacer"

msgid "%d account"
msgid_plural "%d accounts"
msgstr[0] "%d compte"
msgstr[1] "%d comptes"

msgid "%d session"
msgid_plural "%d sessions"
msgstr[0] "%d session"
msgstr[1] "%d sessions"

msgid "no local accounts"
msgstr "aucun compte local"

msgid "no sessions found"
msgstr "aucune session trouvée"

# --- errors and notices -----------------------------------------------------
msgid "Authentication failed"
msgstr "Échec de l’authentification"

msgid "Authentication failure"
msgstr "Échec de l’authentification"

msgid "The password was not accepted."
msgstr "Le mot de passe n’a pas été accepté."

msgid "greetd error"
msgstr "Erreur de greetd"

msgid "greetd accepted the session; it starts as soon as the greeter exits"
msgstr "greetd a accepté la session ; elle démarre dès que l’écran de connexion se ferme"

msgid "not connected to greetd at %s"
msgstr "pas de connexion à greetd sur %s"

msgid "there is no account to log in to"
msgstr "il n’y a aucun compte auquel se connecter"

msgid "%s is a --demo-users placeholder, not a real account; it is never sent to greetd"
msgstr "%s est un exemple de --demo-users, pas un vrai compte ; il n’est jamais envoyé à greetd"

msgid "greetd sent an empty reply"
msgstr "greetd a envoyé une réponse vide"

msgid "greetd reported an error"
msgstr "greetd a signalé une erreur"

msgid "no greetd on %s"
msgstr "pas de greetd sur %s"

msgid "MOCK greetd"
msgstr "greetd SIMULÉ"

msgid "greetd IPC · %s  (F2 hides this)"
msgstr "IPC greetd · %s  (F2 pour masquer)"

msgid "no socket"
msgstr "pas de socket"

msgid "nothing sent yet"
msgstr "rien envoyé pour l’instant"

# --- power ------------------------------------------------------------------
msgid "Suspend"
msgstr "Veille"

msgid "Restart"
msgstr "Redémarrer"

msgid "Shut Down"
msgstr "Éteindre"

msgid "Shutting down…"
msgstr "Arrêt en cours…"

msgid "Restarting…"
msgstr "Redémarrage…"

msgid "power: would run `%s` (stub — nothing executed)"
msgstr "alimentation : lancerait `%s` (simulation — rien n’est exécuté)"

msgid "%s is not available on this machine"
msgstr "%s n’est pas disponible sur cette machine"

msgid "power: palm-login did not answer"
msgstr "alimentation : palm-login n’a pas répondu"

msgid "power: %s"
msgstr "alimentation : %s"

msgid "refused"
msgstr "refusé"

# --- the date ---------------------------------------------------------------
