# Palmframe login screen (apps/greeter) — German.
# Format: distro/locale/README.md. Installed as
# /usr/share/palm/locale/de/greeter.msg.
language = de
name     = Deutsch
english  = German
plural   = n != 1

# --- the card ---------------------------------------------------------------
msgid "Sign in"
msgstr "Anmelden"

msgid "Authenticating"
msgstr "Wird geprüft"

msgid "Session ready"
msgstr "Sitzung bereit"

msgid "Signed in"
msgstr "Angemeldet"

msgid "Password"
msgstr "Passwort"

msgid "Answer"
msgstr "Antwort"

msgid "Enter to sign in · Tab to move · Esc to clear"
msgstr "Eingabe zum Anmelden · Tab zum Wechseln · Esc zum Löschen"

msgid "%d account"
msgid_plural "%d accounts"
msgstr[0] "%d Konto"
msgstr[1] "%d Konten"

msgid "%d session"
msgid_plural "%d sessions"
msgstr[0] "%d Sitzung"
msgstr[1] "%d Sitzungen"

msgid "no local accounts"
msgstr "keine lokalen Konten"

msgid "no sessions found"
msgstr "keine Sitzungen gefunden"

# --- errors and notices -----------------------------------------------------
msgid "Authentication failed"
msgstr "Anmeldung fehlgeschlagen"

msgid "Authentication failure"
msgstr "Anmeldung fehlgeschlagen"

msgid "The password was not accepted."
msgstr "Das Passwort wurde nicht akzeptiert."

msgid "greetd error"
msgstr "greetd-Fehler"

msgid "greetd accepted the session; it starts as soon as the greeter exits"
msgstr "greetd hat die Sitzung angenommen; sie startet, sobald der Anmeldebildschirm schließt"

msgid "not connected to greetd at %s"
msgstr "keine Verbindung zu greetd unter %s"

msgid "there is no account to log in to"
msgstr "es gibt kein Konto zum Anmelden"

msgid "%s is a --demo-users placeholder, not a real account; it is never sent to greetd"
msgstr "%s ist ein Platzhalter von --demo-users, kein echtes Konto; es wird nie an greetd gesendet"

msgid "greetd sent an empty reply"
msgstr "greetd hat eine leere Antwort gesendet"

msgid "greetd reported an error"
msgstr "greetd hat einen Fehler gemeldet"

msgid "no greetd on %s"
msgstr "kein greetd unter %s"

msgid "MOCK greetd"
msgstr "greetd-ATTRAPPE"

msgid "greetd IPC · %s  (F2 hides this)"
msgstr "greetd-IPC · %s  (F2 blendet aus)"

msgid "no socket"
msgstr "kein Socket"

msgid "nothing sent yet"
msgstr "noch nichts gesendet"

# --- power ------------------------------------------------------------------
msgid "Suspend"
msgstr "Bereitschaft"

msgid "Restart"
msgstr "Neu starten"

msgid "Shut Down"
msgstr "Ausschalten"

msgid "Shutting down…"
msgstr "Wird ausgeschaltet…"

msgid "Restarting…"
msgstr "Wird neu gestartet…"

msgid "power: would run `%s` (stub — nothing executed)"
msgstr "Energie: würde `%s` ausführen (Attrappe — nichts ausgeführt)"

msgid "%s is not available on this machine"
msgstr "%s ist auf diesem Rechner nicht verfügbar"

msgid "power: palm-login did not answer"
msgstr "Energie: palm-login hat nicht geantwortet"

msgid "power: %s"
msgstr "Energie: %s"

msgid "refused"
msgstr "abgelehnt"

