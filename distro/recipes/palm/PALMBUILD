# palm, the package manager (distro/palm). The CONTRACT's /sbin/palm is this
# file through /sbin -> usr/bin.
#
# Any first word that is not one of palm's verbs is handed to
# /usr/lib/palm/palm-surface: the application command dispatcher from
# apps/palm, which distro/apps/build.sh builds as palm-apps because the name
# palm belongs to the package manager.
#
# palm fetches over https with its own TLS client, so it carries the CA roots
# it checks servers against: ca-certificates.crt is Mozilla's TLS root set
# (a copy of an Arch host's /etc/ssl/certs/ca-certificates.crt; refreshing it
# is in distro/notes/palm.md). A system bundle at
# /etc/ssl/certs/ca-certificates.crt, if a package ever installs one, wins.
#
# palmframe-release.pub is the key the public repository is signed with
# (distro/repo-publish). The build key in /etc/palm/keys/palmframe.pub
# (palmframe-base) still signs the repository a checkout builds for itself; a
# system trusts both.
pkgname  = palm
pkgver   = 0.2.0
pkgrel   = 0
pkgdesc  = The Palmframe package manager
license  = MIT
category = System
icon     = package
details  = palm installs, removes and upgrades packages from signed repositories, modelled on Alpine's apk: a world file that states what was asked for, every change a fresh resolution of it, and no install scripts of any kind.
details  = Software is a window onto it; everything it shows comes from palm --json.
depend   = palmframe-base glibc
provides = cmd:palm

file     = ${PALMFRAME_OUT}/bin/palm -> /usr/bin/palm mode 0755
file     = ${PALMFRAME_OUT}/bin/palm-apps -> /usr/lib/palm/palm-surface mode 0755
file     = ca-certificates.crt -> /usr/share/palm/ca-certificates.crt mode 0644
file     = palmframe-release.pub -> /etc/palm/keys/palmframe-release.pub mode 0644
dir      = /var/cache/palm
