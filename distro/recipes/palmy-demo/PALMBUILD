# The demo account's home: /home/palm, made from the same skeleton the
# installer gives a new user (palmy-base's /etc/skel). The disk image
# (distro/image/build.sh) installs `palmy palmy-demo`, so its `palm`
# user can log in; the installer installs `palmy` alone and removes the
# `palm` user, so an installed system has no /home/palm for `palm verify` to
# find missing. The user itself stays in palmy-base's /etc/passwd: every
# owner name is resolved against that file, and the installer edits it.
pkgname  = palmy-demo
pkgver   = 0.1.0
pkgrel   = 0
pkgdesc  = The demo user's home directory on the Palmy disk image
license  = MIT
depend   = palmy-base
install_user = palm

dir      = /home/palm mode 0700
file     = ${PALMY_ROOT}/distro/base/root/etc/skel/.profile -> /home/palm/.profile mode 0644
dir      = /home/palm/.config mode 0755
dir      = /home/palm/.cache mode 0755
dir      = /home/palm/.local mode 0755
dir      = /home/palm/.local/share mode 0755
dir      = /home/palm/.local/state mode 0755
owner    = /home/palm palm:palm
owner    = /home/palm/** palm:palm
