# What the runtime packages need from the kernel, as a fragment for
# distro/kernel/palmy.config (owned by the kernel side; proposed here,
# and what test-runtime.py --kernel was verified with).
#
# iwd does its cryptography through the kernel: AF_ALG hashes and ciphers,
# keyctl Diffie-Hellman, and the X.509/PKCS parsers for EAP-TLS. Without
# these it prints the list and exits.
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_SHA1_SSSE3=y
CONFIG_CRYPTO_SHA256_SSSE3=y
CONFIG_CRYPTO_SHA512_SSSE3=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
#
# Wi-Fi: cfg80211/mac80211 are already on through defconfig. Drivers for
# real hardware are a separate decision (iwlwifi needs firmware files);
# mac80211_hwsim gives QEMU two virtual radios to test iwd against.
CONFIG_WLAN=y
CONFIG_MAC80211_HWSIM=y
CONFIG_RFKILL=y
#
# Bluetooth: the core, the management interface bluetoothd needs, USB and
# UART controllers, and the virtual HCI for testing.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIVHCI=y
#
# Sound for USB headsets, beyond the HDA already configured.
CONFIG_SND_USB_AUDIO=y
