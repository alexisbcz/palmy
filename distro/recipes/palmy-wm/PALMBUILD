# The window manager (apps/wm): a Wayland compositor that drives KMS and
# evdev directly on Palmy (`wm --drm`, no logind), and the nested
# compositor it always was elsewhere.
pkgname  = palmy-wm
pkgver   = 0.1.0
pkgrel   = 0
pkgdesc  = The palmy Wayland window manager
license  = MIT
category = System
icon     = layout-grid
details  = A tiling and floating Wayland compositor that drives the display and input devices directly, with workspaces, a bar and every key binding in one text file.
depend   = glibc fonts
provides = cmd:wm

file     = ${PALMY_OUT}/bin/wm -> /usr/bin/wm mode 0755
