# Built by distro/recipes/palm-browser-cef/build.sh, not by `make -C distro`:
# its input is a 320 MB download. The recipe sits one directory down so the
# image build's recipes/*/PALMBUILD glob does not try to pack it without it.
pkgname  = palm-browser-cef
pkgver   = 152.0.7977.167
pkgrel   = 0
pkgdesc  = Chromium engine for the browser (CEF 152, off-screen)
license  = BSD-3-Clause AND LGPL-2.1-or-later AND MIT AND others (see CREDITS.html in CEF)
url      = https://bitbucket.org/chromiumembedded/cef
category = Internet
icon     = globe
details  = Chromium's Blink and V8, through the Chromium Embedded Framework's off-screen rendering, for the browser app. Pages are drawn into shared memory and shown inside the browser's own window; renderer processes run in Chromium's user-namespace sandbox with a seccomp filter.
details  = The libraries libcef.so needs that Palmy does not otherwise ship (NSS, GLib, ATK, cups, the X11 client libraries) are copied from the build host into a directory of the package's own.
depend   = glibc fonts browser
provides = palm-browser-engine

tree     = ${PALMY_OUT}/palm-browser-cef -> /usr/lib/palm-browser/cef
