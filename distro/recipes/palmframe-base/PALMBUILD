# Generated by distro/recipes/generate.sh from distro/base/root and distro/base/layout -- do not edit;
# change the source and run `make -C distro recipes`.
#
# The filesystem itself: merged /usr, /etc (users, services, repositories),
# the mount points palm-init mounts on, and palm's own home. Every other
# package depends on this one, so it is always installed first and its
# /etc/passwd is in place when later packages' owners are resolved.
pkgname  = palmframe-base
pkgver   = 0.1.0
pkgrel   = 0
pkgdesc  = The Palmframe filesystem layout, users and base configuration
license  = MIT
install_user = root
install_user = palm
install_user = greeter

tree     = ${PALMFRAME_ROOT}/distro/base/root/etc -> /etc
tree     = ${PALMFRAME_ROOT}/distro/base/root/home -> /home
tree     = ${PALMFRAME_ROOT}/distro/base/root/usr -> /usr
file     = ${PALMFRAME_KEYS}/palmframe.pub -> /etc/palm/keys/palmframe.pub mode 0644

dir      = /usr mode 0755
dir      = /usr/bin mode 0755
dir      = /usr/lib mode 0755
dir      = /usr/share mode 0755
dir      = /usr/local mode 0755
dir      = /usr/local/bin mode 0755
symlink  = /bin -> usr/bin
symlink  = /sbin -> usr/bin
symlink  = /lib -> usr/lib
symlink  = /lib64 -> usr/lib
symlink  = /usr/sbin -> bin
symlink  = /usr/lib64 -> lib
dir      = /proc mode 0555
dir      = /sys mode 0555
dir      = /dev mode 0755
dir      = /run mode 0755
dir      = /tmp mode 1777
dir      = /mnt mode 0755
dir      = /boot mode 0755
dir      = /root mode 0700
dir      = /home mode 0755
dir      = /home/palm mode 0700
owner    = /home/palm palm:palm
owner    = /home/palm/.profile palm:palm
dir      = /home/palm/.config mode 0755
owner    = /home/palm/.config palm:palm
dir      = /home/palm/.cache mode 0755
owner    = /home/palm/.cache palm:palm
dir      = /home/palm/.local mode 0755
owner    = /home/palm/.local palm:palm
dir      = /home/palm/.local/share mode 0755
owner    = /home/palm/.local/share palm:palm
dir      = /home/palm/.local/state mode 0755
owner    = /home/palm/.local/state palm:palm
dir      = /var mode 0755
dir      = /var/log mode 0755
dir      = /var/tmp mode 1777
dir      = /var/cache mode 0755
dir      = /var/cache/palm mode 0755
dir      = /var/lib mode 0755
dir      = /var/lib/greeter mode 0750
owner    = /var/lib/greeter greeter:greeter
symlink  = /var/run -> ../run
symlink  = /var/lock -> ../run/lock
symlink  = /etc/mtab -> ../proc/self/mounts
mode     = /etc/shadow 0600
mode     = /usr/share/udhcpc/default.script 0755
dir      = /etc/palm/keys mode 0755
