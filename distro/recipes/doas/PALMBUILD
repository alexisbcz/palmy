# doas (distro/doas): run a command as root, after your own password, if
# /etc/doas.conf says you may. Setuid root: the `mode` on the file line is
# what makes it work, and palm applies it after the owner (chown clears the
# setuid bit, so the order matters; distro/palm/install.odin).
pkgname  = doas
pkgver   = 0.1.0
pkgrel   = 0
pkgdesc  = Run a command as root, after your own password
license  = MIT
category = System
icon     = shield-check
details  = OpenBSD's doas, rewritten small in Odin for Palmy: one policy file, /etc/doas.conf, which by default lets members of wheel run anything after typing their own password. `doas palm add foo` installs a package from a terminal.
details  = It refuses a policy anyone but root could change, looks commands up only in /usr/local/bin, /usr/bin and /bin, passes on almost none of the caller's environment, slows down after repeated wrong passwords, and logs every grant and refusal to /var/log/messages.
depend   = palmy-base glibc
provides = cmd:doas

file     = ${PALMY_OUT}/bin/doas -> /usr/bin/doas mode 4755
file     = ${PALMY_ROOT}/distro/doas/doas.conf -> /etc/doas.conf mode 0644
