# The graphical installer (apps/installer): language, keyboard, time zone,
# disk, account, then install_core does the work. The live image runs it as
# root inside `wm --drm --kiosk` (distro/live). It reads the catalogues in
# palm-locale, the layouts in xkeyboard-config and the zones in tzdata, and
# formats with the same tools as palm-install. Built by distro/Makefile into
# distro/out/bin/installer.
pkgname  = installer
pkgver   = 0.1.0
pkgrel   = 0
pkgdesc  = Install Palmframe onto a disk (graphical)
license  = MIT
depend   = glibc fonts libxkbcommon palmy-wm palm-locale tzdata xkeyboard-config
depend   = palm e2fsprogs dosfstools limine
provides = cmd:installer

file     = ${PALMFRAME_OUT}/bin/installer -> /usr/bin/installer mode 0755
