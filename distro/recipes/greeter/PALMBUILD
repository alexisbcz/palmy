# The login screen (apps/greeter), run by palm-login inside
# `wm --drm --kiosk --exec greeter`.
pkgname  = greeter
pkgver   = 0.1.0
pkgrel   = 0
pkgdesc  = The palmy login screen
license  = MIT
category = System
icon     = user
details  = The screen you log in on: the clock, the accounts, the session, and Restart and Shut Down.
depend   = glibc fonts libxkbcommon
provides = cmd:greeter

file     = ${PALMY_OUT}/bin/greeter -> /usr/bin/greeter mode 0755
