# passwd (distro/passwd): change a password. Setuid root, because
# /etc/shadow is root's alone; it replaces busybox's passwd applet, which
# cannot work for anyone but root since busybox is not setuid.
pkgname  = passwd
pkgver   = 0.1.0
pkgrel   = 0
pkgdesc  = Change your password
license  = MIT
category = System
icon     = lock
details  = Asks for the current password, then the new one twice, and rewrites /etc/shadow atomically under the same locks busybox's and shadow-utils' tools take. Root can also set, lock, unlock and expire any account's password.
depend   = palmframe-base glibc
provides = cmd:passwd

file     = ${PALMFRAME_OUT}/bin/passwd -> /usr/bin/passwd mode 4755
