#
# The filesystem itself: merged /usr, /etc (users, services, repositories),
# the mount points palm-init mounts on, and /etc/skel. Every other
# package depends on this one, so it is always installed first and its
# /etc/passwd is in place when later packages' owners are resolved.
pkgname  = palmy-base
pkgver   = 0.1.0
pkgrel   = 0
pkgdesc  = The Palmy filesystem layout, users and base configuration
license  = MIT
category = System
icon     = hard-drive
details  = The skeleton every other package stands on: merged /usr, /etc with the users, groups and services, the repository list and its signing key, and the mount points palm-init mounts on.
install_user = root
install_user = palm
install_user = greeter

tree     = ${PALMY_ROOT}/distro/base/root/etc -> /etc
tree     = ${PALMY_ROOT}/distro/base/root/usr -> /usr
file     = ${PALMY_KEYS}/palmy.pub -> /etc/palm/keys/palmy.pub mode 0644

dir      = /usr mode 0755
dir      = /usr/bin mode 0755
dir      = /usr/lib mode 0755
dir      = /usr/share mode 0755
dir      = /usr/local mode 0755
dir      = /usr/local/bin mode 0755
symlink  = /bin -> usr/bin
symlink  = /sbin -> usr/bin
symlink  = /lib -> usr/lib
symlink  = /lib64 -> usr/lib
symlink  = /usr/sbin -> bin
symlink  = /usr/lib64 -> lib
dir      = /proc mode 0555
dir      = /sys mode 0555
dir      = /dev mode 0755
dir      = /run mode 0755
dir      = /tmp mode 1777
dir      = /mnt mode 0755
dir      = /boot mode 0755
dir      = /root mode 0700
dir      = /home mode 0755
dir      = /etc/skel mode 0755
dir      = /etc/skel/.config mode 0755
dir      = /etc/skel/.cache mode 0755
dir      = /etc/skel/.local mode 0755
dir      = /etc/skel/.local/share mode 0755
dir      = /etc/skel/.local/state mode 0755
dir      = /var mode 0755
dir      = /var/log mode 0755
dir      = /var/tmp mode 1777
dir      = /var/cache mode 0755
dir      = /var/cache/palm mode 0755
dir      = /var/lib mode 0755
dir      = /var/lib/greeter mode 0750
owner    = /var/lib/greeter greeter:greeter
symlink  = /var/run -> ../run
symlink  = /var/lock -> ../run/lock
symlink  = /etc/mtab -> ../proc/self/mounts
symlink  = /etc/localtime -> ../usr/share/zoneinfo/UTC
mode     = /etc/shadow 0600
mode     = /usr/share/udhcpc/default.script 0755
mode     = /usr/lib/palmy/syslog 0755
dir      = /etc/palm/keys mode 0755
dir      = /etc/palm/early.d mode 0755
