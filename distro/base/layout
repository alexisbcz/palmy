# The parts of the palmframe-base filesystem that are not plain files in
# distro/base/root: directories with special modes, the merged-/usr symlinks,
# and the owners that differ from root:root. The image builder (and the
# palmframe-base PALMBUILD recipe) applies these on top of copying root/.
#
#	dir     <path> <mode> [owner:group]
#	symlink <path> <target>
#	mode    <path> <mode>
#	owner   <path> <owner:group>
#
# Owners are numeric so they mean the same thing before /etc/passwd exists.

# Merged /usr, as in the CONTRACT. glibc's loader is found as
# /lib64/ld-linux-x86-64.so.2 through these.
dir     usr             0755
dir     usr/bin         0755
dir     usr/lib         0755
dir     usr/share       0755
dir     usr/local       0755
dir     usr/local/bin   0755
symlink bin             usr/bin
symlink sbin            usr/bin
symlink lib             usr/lib
symlink lib64           usr/lib
symlink usr/sbin        bin
symlink usr/lib64       lib

# Mount points palm-init mounts on (it creates missing ones, but a read-only
# root at first boot cannot get them created).
dir     proc            0555
dir     sys             0555
dir     dev             0755
dir     run             0755
dir     tmp             1777
dir     mnt             0755
dir     boot            0755

dir     root            0700
dir     home            0755
# What a new user's home starts as. The installer copies /etc/skel into the
# account it creates; the disk image's demo user `palm` gets the same tree
# from the palmframe-demo package, so palmframe-base owns nothing under /home
# and an installed system (where `palm` is removed) still verifies clean.
# The XDG directories applications expect to find: several create their data
# directory with a plain (non-recursive) mkdir of ~/.local/share/<app>, and
# notes' first-run note fails without it (distro/notes/apps.md).
dir     etc/skel                0755
dir     etc/skel/.config        0755
dir     etc/skel/.cache         0755
dir     etc/skel/.local         0755
dir     etc/skel/.local/share   0755
dir     etc/skel/.local/state   0755
dir     var             0755
dir     var/log         0755
dir     var/tmp         1777
dir     var/cache       0755
dir     var/cache/palm  0755
dir     var/lib         0755
dir     var/lib/greeter 0750  900:900
symlink var/run         ../run
symlink var/lock        ../run/lock
symlink etc/mtab        ../proc/self/mounts
# The time zone, as glibc and the greeter's clock read it: a symlink into
# tzdata, and its name in /etc/timezone. UTC until the installer points it at
# the zone picked, or the image builder at TIMEZONE= (distro/image/build.sh).
# Without the tzdata package installed the link dangles, and everything that
# reads it falls back to UTC — the same answer.
symlink etc/localtime   ../usr/share/zoneinfo/UTC

mode    etc/shadow      0600
mode    usr/share/udhcpc/default.script 0755
mode    usr/lib/palmframe/syslog 0755
dir     etc/palm/keys   0755
# The administrator's early-boot hooks (distro/notes/init.md); packages put
# theirs in /usr/lib/palm-init/early.d, which palm-init owns.
dir     etc/palm/early.d 0755
