package main

// The fixture deck.
//
// An editor that opens empty cannot be judged, so the binary ships with a real
// deck: eight slides that use every layout, every text style, shapes with
// rotation and stroke, both generated pictures, and speaker notes on each. It
// is also the deck the demo recording drives, and the one `--export` renders.
// Three of its slides carry styled runs and four arrive with a transition, so
// both are exercised by every export and every demo.

import "core:strings"

fixture_deck :: proc() -> Deck {
	d := Deck {
		version = DECK_VERSION,
		title   = "Drawing a desktop from scratch",
		author  = "palmy",
		theme   = THEMES[0],
		slides  = make([dynamic]Slide),
	}

	// 1 — title
	{
		s := slide_make(.Title)
		append(&s.elems, text_box("Drawing a desktop\nfrom scratch", .Title, 140, 212, 1000, 190, .Center))
		append(&s.elems, text_box("A presentation editor in Odin, on a software rasterizer", .Subtitle, 140, 418, 1000, 70, .Center))
		append(&s.elems, text_box("palmy  ·  slides.bin", .Caption, 140, 600, 1000, 40, .Center))
		s.notes = "Open on the title. Say the whole thing is three dynamic libraries: libc, libm, vdso.\n\nPress Right to begin."
		append(&d.slides, s)
	}

	// 2 — section header
	{
		s := slide_make(.Section_Header)
		append(&s.elems, text_box("Why a slide editor", .Title, 140, 288, 1000, 110))
		append(&s.elems, text_box("It is the hardest thing you can ask of a 2D renderer", .Subtitle, 140, 416, 1000, 70))
		append(&s.elems, text_box("01", .Metric, 940, 180, 240, 160, .Right))
		s.elems[len(s.elems) - 1].color = SLOT_ACCENT
		s.elems[len(s.elems) - 1].opacity = 0.35
		s.transition = .Push
		s.notes = "Text, shapes, pictures, z-order, hit testing, a second surface for the projector. Everything a toolkit can get wrong is here."
		append(&d.slides, s)
	}

	// 3 — title and content
	{
		s := slide_make(.Title_Content)
		append(&s.elems, text_box("The slide is the model", .Title, MARGIN, 72, 1120, 96))
		append(
			&s.elems,
			text_box(
				"- A deck is a title, a theme and a list of slides\n- A slide is a layout, speaker notes and elements in paint order\n- An element is a rectangle in a fixed 1280x720 space\n- Colours name theme slots, so one keystroke restyles the deck\n- The whole thing is plain data, so JSON is the native format",
				.Bullets,
				MARGIN,
				208,
				1000,
				400,
			),
		)
		// Styled runs: one box, several looks.
		mark(&s.elems[1], "theme slots", .Color, color = SLOT_ACCENT)
		mark(&s.elems[1], "theme slots", .Bold)
		mark(&s.elems[1], "plain data", .Italic)
		mark(&s.elems[1], "JSON", .Bold)
		s.transition = .Fade
		s.notes = "Paint order is array order. Raising an element is a swap; bringing it to the front is a move to the end of the array. No separate z field to keep consistent."
		append(&d.slides, s)
	}

	// 4 — two content
	{
		s := slide_make(.Two_Content)
		append(&s.elems, text_box("One renderer, four jobs", .Title, MARGIN, 72, 1120, 96))
		append(&s.elems, text_box("- The editing canvas\n- The sorter thumbnails\n- The fullscreen projector\n- The PNG exporter", .Bullets, MARGIN, 232, 500, 340))
		append(&s.elems, text_box("- Scaled from slide space\n- Measured at the size it draws\n- Same text wrapping everywhere\n- A thumbnail is the real slide", .Bullets, 660, 232, 500, 340))
		append(&s.elems, shape(.Rect, MARGIN - 16, 208, 532, 390, SLOT_SURFACE))
		s.elems[len(s.elems) - 1].fill_a = 0.55
		elem_to_back(&s, len(s.elems) - 1)
		s.transition = .Wipe
		s.notes = "A sorter that shows placeholders is worse than useless. These thumbnails are the renderer at 160 pixels wide."
		append(&d.slides, s)
	}

	// 5 — picture
	{
		s := slide_make(.Picture)
		append(&s.elems, text_box("Pictures composite\nlike anything else", .Title, MARGIN, 72, 1120, 140))
		append(&s.elems, image_box("assets/vista.png", MARGIN, 252, 600, 360))
		append(
			&s.elems,
			text_box(
				"stb_image decodes PNG, JPEG, BMP, GIF, TGA and more into straight 0xAARRGGBB pixels. The sampler here is bilinear, rounds the corners and follows the element's rotation.",
				.Body,
				730,
				262,
				470,
				300,
			),
		)
		s.notes = "The picture is generated by the binary itself with --make-assets, written through the same PNG writer the exporter uses."
		append(&d.slides, s)
	}

	// 6 — shapes
	{
		s := slide_make(.Blank)
		append(&s.elems, text_box("Shapes, strokes, rotation", .Title, MARGIN, 72, 1120, 96))
		append(&s.elems, shape(.Rect, 110, 250, 240, 170, SLOT_ACCENT))
		append(&s.elems, shape(.Rect, 300, 320, 240, 170, SLOT_ACCENT2))
		s.elems[len(s.elems) - 1].rotation = -12
		s.elems[len(s.elems) - 1].fill_a = 0.9
		append(&s.elems, shape(.Ellipse, 600, 250, 220, 220, SLOT_NONE, SLOT_ACCENT))
		s.elems[len(s.elems) - 1].stroke_w = 8
		append(&s.elems, shape(.Arrow, 860, 300, 220, 120, SLOT_FG))
		append(&s.elems, text_box("Every edge is a signed distance field, evaluated in the shape's own rotated frame.", .Caption, 110, 540, 520, 60))
		mark(&s.elems[len(s.elems) - 1], "signed distance field", .Italic)
		s.transition = .Push
		s.notes = "Rotation is applied by inverse transforming each pixel into the shape's frame. Text boxes stay upright, which is the one thing this renderer will not rotate."
		append(&d.slides, s)
	}

	// 7 — the metric
	{
		s := slide_make(.Blank)
		append(&s.elems, text_box("What it costs", .Title, MARGIN, 72, 1120, 96))
		append(&s.elems, text_box("3", .Metric, MARGIN, 230, 260, 180))
		s.elems[len(s.elems) - 1].color = SLOT_ACCENT
		append(&s.elems, text_box("dynamic libraries:\nlibc, libm, vdso", .Body, MARGIN, 420, 300, 120))
		append(&s.elems, image_box("assets/bars.png", 480, 212, 700, 400))
		append(&s.elems, text_box("Frames drawn per second, 1080p, one core", .Caption, 480, 630, 700, 40))
		mark(&s.elems[2], "libc, libm, vdso", .Color, color = SLOT_ACCENT2)
		mark(&s.elems[2], "libc, libm, vdso", .Size, size = 34)
		s.notes = "No GPU driver, no libwayland, no font library. The chart is drawn with palmy's own rasterizer and saved as a PNG at build time."
		append(&d.slides, s)
	}

	// 8 — close
	{
		s := slide_make(.Title)
		append(&s.elems, text_box("Press Escape to\nleave the projector", .Title, 140, 230, 1000, 180, .Center))
		append(&s.elems, text_box("F5 presents · Tab is the presenter view · Ctrl+E exports PNGs", .Subtitle, 140, 436, 1000, 70, .Center))
		s.notes = "Last slide. Escape returns to the editor, which comes back with the same slide selected."
		append(&d.slides, s)
	}

	for &s in d.slides {
		for &e in s.elems {
			normalise(&e)
		}
	}
	return d
}

// mark styles the first occurrence of `word` in a fixture text box.
@(private = "file")
mark :: proc(e: ^Element, word: string, op: Style_Op, color: u32 = 0, size: f32 = 0) {
	at := strings.index(e.text, word)
	if at < 0 {
		return
	}
	e.runs = runs_apply(e.runs, len(e.text), at, at + len(word), op, true, color, size)
}
