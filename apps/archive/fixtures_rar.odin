package main

// RAR fixtures for the self-test, made once with RARLAB's rar 7.00 (the
// Ubuntu multiverse amd64 package, run under Rosetta in the arm64 build VM),
// because nothing installed here can write a RAR and the reading backends
// still have to be tested against real ones. -m0 stores the data rather than
// compressing it, which keeps them small. See the self-test for what each one holds.
//
//   rar a -ol -m0 -tl hostile.rar docs evil.txt; rar rn hostile.rar evil.txt ../../evil.txt
//   rar a -hp -m0 locked.rar secret.txt               (password rar-pass, names hidden)
//   rar a -p  -m0 filelocked.rar secret.txt docs/readme.md   (password rar-pass)

