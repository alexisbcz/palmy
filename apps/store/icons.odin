icon_named :: proc(name: string) -> p.Icon {
	switch name {
	case "package":
		return ICON_PACKAGE
	case "search":
		return ICON_SEARCH
	case "x":
		return ICON_X
	case "arrow-left":
		return ICON_ARROW_LEFT
	case "chevron-right":
		return ICON_CHEVRON_RIGHT
	case "download":
		return ICON_DOWNLOAD
	case "trash":
		return ICON_TRASH
	case "external-link":
		return ICON_EXTERNAL_LINK
	case "refresh-cw":
		return ICON_REFRESH_CW
	case "circle-check":
		return ICON_CIRCLE_CHECK
	case "circle-alert":
		return ICON_CIRCLE_ALERT
	case "triangle-alert":
		return ICON_TRIANGLE_ALERT
	case "loader-circle":
		return ICON_LOADER_CIRCLE
	case "layout-grid":
		return ICON_LAYOUT_GRID
	case "sparkles":
		return ICON_SPARKLES
	case "scissors":
		return ICON_SCISSORS
	case "code":
		return ICON_CODE
	case "palette":
		return ICON_PALETTE
	case "globe":
		return ICON_GLOBE
	case "film":
		return ICON_FILM
	case "music":
		return ICON_MUSIC
	case "file-text":
		return ICON_FILE_TEXT
	case "star":
		return ICON_STAR
	case "settings":
		return ICON_SETTINGS
	case "hard-drive":
		return ICON_HARD_DRIVE
	case "info":
		return ICON_INFO
	case "shield-check":
		return ICON_SHIELD_CHECK
	case "lock":
		return ICON_LOCK
	case "folder":
		return ICON_FOLDER
	case "file":
		return ICON_FILE
	case "link":
		return ICON_LINK
	case "user":
		return ICON_USER
	case "square-terminal":
		return ICON_SQUARE_TERMINAL
	case "activity":
		return ICON_ACTIVITY
	case "calculator":
		return ICON_CALCULATOR
	case "map-pin":
		return ICON_MAP_PIN
	case "flag":
		return ICON_FLAG
	case "calendar-days":
		return ICON_CALENDAR_DAYS
	case "notebook-pen":
		return ICON_NOTEBOOK_PEN
	case "file-spreadsheet":
		return ICON_FILE_SPREADSHEET
	case "presentation":
		return ICON_PRESENTATION
	case "calendar":
		return ICON_CALENDAR
	case "book-open":
		return ICON_BOOK_OPEN
	case "credit-card":
		return ICON_CREDIT_CARD
	case "type":
		return ICON_TYPE
	case "image":
		return ICON_IMAGE
	case "tag":
		return ICON_TAG
	case "terminal":
		return ICON_TERMINAL
	case "binary":
		return ICON_BINARY
	case "keyboard":
		return ICON_KEYBOARD
	case "server":
		return ICON_SERVER
	case "lock-keyhole":
		return ICON_LOCK_KEYHOLE
	case "monitor":
		return ICON_MONITOR
	case "check":
		return ICON_CHECK
	case "arrow-right":
		return ICON_ARROW_RIGHT
	case "plus":
		return ICON_PLUS
	case "minus":
		return ICON_MINUS
	}
	return ICON_PACKAGE
}
