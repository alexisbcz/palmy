// icon_named is the lucide icon of that name, for Icon= lines.
icon_named :: proc(name: string) -> (p.Icon, bool) {
	switch name {
	case "square-terminal":
		return ICON_SQUARE_TERMINAL, true
	case "terminal":
		return ICON_TERMINAL, true
	case "folder":
		return ICON_FOLDER, true
	case "folder-open":
		return ICON_FOLDER_OPEN, true
	case "code":
		return ICON_CODE, true
	case "notebook-pen":
		return ICON_NOTEBOOK_PEN, true
	case "calculator":
		return ICON_CALCULATOR, true
	case "activity":
		return ICON_ACTIVITY, true
	case "image":
		return ICON_IMAGE, true
	case "file-text":
		return ICON_FILE_TEXT, true
	case "file-spreadsheet":
		return ICON_FILE_SPREADSHEET, true
	case "sheet":
		return ICON_SHEET, true
	case "presentation":
		return ICON_PRESENTATION, true
	case "calendar":
		return ICON_CALENDAR, true
	case "calendar-days":
		return ICON_CALENDAR_DAYS, true
	case "book-open":
		return ICON_BOOK_OPEN, true
	case "palette":
		return ICON_PALETTE, true
	case "map-pin":
		return ICON_MAP_PIN, true
	case "credit-card":
		return ICON_CREDIT_CARD, true
	case "wallet":
		return ICON_WALLET, true
	case "download":
		return ICON_DOWNLOAD, true
	case "package":
		return ICON_PACKAGE, true
	case "layout-grid":
		return ICON_LAYOUT_GRID, true
	case "sparkles":
		return ICON_SPARKLES, true
	case "flag":
		return ICON_FLAG, true
	case "tag":
		return ICON_TAG, true
	case "globe":
		return ICON_GLOBE, true
	case "mail":
		return ICON_MAIL, true
	case "music":
		return ICON_MUSIC, true
	case "clapperboard":
		return ICON_CLAPPERBOARD, true
	case "scissors":
		return ICON_SCISSORS, true
	case "volume-2":
		return ICON_VOLUME_2, true
	case "bluetooth":
		return ICON_BLUETOOTH, true
	case "archive":
		return ICON_ARCHIVE, true
	case "phone":
		return ICON_PHONE, true
	case "clipboard":
		return ICON_CLIPBOARD, true
	case "key-round":
		return ICON_KEY_ROUND, true
	case "bot":
		return ICON_BOT, true
	case "scan-text":
		return ICON_SCAN_TEXT, true
	case "message-circle":
		return ICON_MESSAGE_CIRCLE, true
	case "hard-drive":
		return ICON_HARD_DRIVE, true
	case "contact":
		return ICON_CONTACT, true
	case "anvil":
		return ICON_ANVIL, true
	case "circle-user":
		return ICON_CIRCLE_USER, true
	case "house":
		return ICON_HOUSE, true
	case "settings":
		return ICON_SETTINGS, true
	case "battery":
		return ICON_BATTERY, true
	case "wifi":
		return ICON_WIFI, true
	case "captions":
		return ICON_CAPTIONS, true
	case "pipette":
		return ICON_PIPETTE, true
	case "camera":
		return ICON_CAMERA, true
	case "cpu":
		return ICON_CPU, true
	case "search":
		return ICON_SEARCH, true
	case "pin":
		return ICON_PIN, true
	case "pin-off":
		return ICON_PIN_OFF, true
	case "power":
		return ICON_POWER, true
	case "log-out":
		return ICON_LOG_OUT, true
	case "lock":
		return ICON_LOCK, true
	case "rotate-ccw":
		return ICON_ROTATE_CCW, true
	case "user":
		return ICON_USER, true
	case "users":
		return ICON_USERS, true
	case "chevron-right":
		return ICON_CHEVRON_RIGHT, true
	case "chevron-left":
		return ICON_CHEVRON_LEFT, true
	case "chevron-down":
		return ICON_CHEVRON_DOWN, true
	case "clock":
		return ICON_CLOCK, true
	case "file":
		return ICON_FILE, true
	case "monitor":
		return ICON_MONITOR, true
	case "keyboard":
		return ICON_KEYBOARD, true
	case "mouse-pointer-2":
		return ICON_MOUSE_POINTER_2, true
	case "mouse":
		return ICON_MOUSE, true
	case "refresh-cw":
		return ICON_REFRESH_CW, true
	case "info":
		return ICON_INFO, true
	case "sun":
		return ICON_SUN, true
	case "moon":
		return ICON_MOON, true
	case "sun-moon":
		return ICON_SUN_MOON, true
	case "x":
		return ICON_X, true
	case "check":
		return ICON_CHECK, true
	case "plus":
		return ICON_PLUS, true
	case "external-link":
		return ICON_EXTERNAL_LINK, true
	case "app-window":
		return ICON_APP_WINDOW, true
	case "arrow-left-right":
		return ICON_ARROW_LEFT_RIGHT, true
	case "panel-top":
		return ICON_PANEL_TOP, true
	case "layout-dashboard":
		return ICON_LAYOUT_DASHBOARD, true
	case "type":
		return ICON_TYPE, true
	case "store":
		return ICON_STORE, true
	case "languages":
		return ICON_LANGUAGES, true
	case "shield-check":
		return ICON_SHIELD_CHECK, true
	case "network":
		return ICON_NETWORK, true
	case "ethernet-port":
		return ICON_ETHERNET_PORT, true
	case "list":
		return ICON_LIST, true
	case "arrow-up-right":
		return ICON_ARROW_UP_RIGHT, true
	case "bell":
		return ICON_BELL, true
	}
	return {}, false
}
