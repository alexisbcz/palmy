package main

// The synthetic corpus.
//
// Every byte of mail in this file was written for this test server. None of it
// came from a real mailbox, no address in it resolves anywhere, and the two
// account passwords below were invented here and exist nowhere else.
//
// The corpus is built to be nasty on purpose. Each entry carries, next to the
// raw octets, a HAND-AUTHORED reading of what the message says: the decoded
// subject, the sender, the body text a human sees. The JMAP front end serves
// those authored values as its decomposed Email object, which is what makes
// the cross-protocol test worth running: the client's MIME parser is checked
// against a person's reading of the message, not against another copy of
// itself.
//
// Generated by scratchpad/gen_corpus.py; the authored fields are the point, so
// read them as the specification of what this corpus means.
import "core:strings"

Corpus_Entry :: struct {
	name:        string,
	folder:      string,
	flags:       Flags,
	raw_lf:      string, // authored with LF; converted to CRLF on load
	note:        string,
	subject:     string,
	from_name:   string,
	from_email:  string,
	to_name:     string,
	to_email:    string,
	message_id:  string,
	in_reply_to: []string,
	references:  []string,
	sent_at:     string,
	text:        string,
	html:        string,
	atts:        []Corpus_Att,
}

Corpus_Att :: struct {
	name:        string,
	type:        string,
	size:        int,
	disposition: string,
	cid:         string,
}
@(rodata)
CORPUS := []Corpus_Entry{
	{
		name = "plain",
		folder = "INBOX",
		flags = {},
		note = "baseline: single part, us-ascii, 7bit",
