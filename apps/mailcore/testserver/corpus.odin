// to_crlf converts the authored LF text into the CRLF a message must use on
// the wire. Mail is a CRLF protocol; authoring with LF is a convenience, and
// this is where it is paid back.
to_crlf :: proc(s: string, allocator := context.allocator) -> []u8 {
	sb := strings.builder_make(allocator)
	for i := 0; i < len(s); i += 1 {
		if s[i] == '\r' {
			continue
		}
		if s[i] == '\n' {
			strings.write_string(&sb, "\r\n")
			continue
		}
		strings.write_byte(&sb, s[i])
	}
	return transmute([]u8)strings.to_string(sb)
}

// corpus_decomp turns an entry's authored fields into the structured view the
// JMAP front end serves.
corpus_decomp :: proc(e: Corpus_Entry, allocator := context.allocator) -> Decomp {
	d := Decomp {
		subject     = e.subject,
		from_name   = e.from_name,
		from_email  = e.from_email,
		to_name     = e.to_name,
		to_email    = e.to_email,
		message_id  = e.message_id,
		in_reply_to = e.in_reply_to,
		references  = e.references,
		sent_at     = e.sent_at,
		authored    = true,
	}
	tb := make([dynamic]Body_Part_Spec, 0, 1, allocator)
	if e.text != "" {
		append(
			&tb,
			Body_Part_Spec {
				part_id = "1",
				blob_id = "",
				type = "text/plain",
				charset = "utf-8",
				size = len(e.text),
				value = e.text,
			},
		)
	}
	d.text_body = tb[:]
	hb := make([dynamic]Body_Part_Spec, 0, 1, allocator)
	if e.html != "" {
		append(
			&hb,
			Body_Part_Spec {
				part_id = "2",
				type = "text/html",
				charset = "utf-8",
				size = len(e.html),
				value = e.html,
			},
		)
	}
	d.html_body = hb[:]
	atts := make([dynamic]Body_Part_Spec, 0, len(e.atts), allocator)
	for a, i in e.atts {
		append(
			&atts,
			Body_Part_Spec {
				part_id = "",
				blob_id = "",
				type = a.type,
				name = a.name,
				disposition = a.disposition,
				cid = a.cid,
				size = a.size,
			},
		)
		_ = i
	}
	d.attachments = atts[:]
	d.has_attachment = len(e.atts) > 0
	prev := e.text != "" ? e.text : e.html
	if len(prev) > 200 {
		prev = prev[:200]
	}
	d.preview = prev
	d.structure = Body_Part_Spec {
		part_id = "0",
		type    = len(e.atts) > 0 ? "multipart/mixed" : (e.text != "" && e.html != "" ? "multipart/alternative" : (e.text != "" ? "text/plain" : "text/html")),
	}
	return d
}
