# Dependencies
node_modules/

# Compiled binaries — everything here is reproducible with `make` or the
# documented odin build command.
*.bin
bin/
.scratch/
*.log

# Generated comparison artifacts. The browser captures and the Odin renders are
# regenerated by `parity/tools/diff-all.sh`; the geometry specs, the metrics and
# the report are kept because they are the measured result.
parity/out/web/*.png
parity/out/odin/
parity/out/diff/*.png

# Editor / OS
.DS_Store
*.swp

# Generated test media and scratch output. Agents synthesise clips, tones and
# speech with ffmpeg/espeak to exercise their pipelines; none of it is source.
# demo.mp4 is deliberately not matched — those are the deliverables.
*.wav
*.pcm
*.raw
apps/*/fixtures/
apps/*/test-media/
apps/*/out/
apps/*/tmp/

# Model weights, should any ever land here. They belong on disk, not in git.
*.gguf
*.safetensors
*.onnx
