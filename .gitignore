# Dependencies
node_modules/

# Compiled binaries — everything here is reproducible with `make` or the
# documented odin build command.
*.bin
bin/
# ...except the hand-written scripts packages install into /usr/bin, which
# are source (iwd's resolvconf shim was silently left out by the line above).
!distro/recipes/runtime/files/*/usr/bin/
!distro/base/root/usr/bin/
.scratch/
*.log

# Generated comparison artifacts. The browser captures and the Odin renders are
# regenerated by `parity/tools/diff-all.sh`; the geometry specs, the metrics and
# the report are kept because they are the measured result.
parity/out/web/*.png
parity/out/odin/
parity/out/diff/*.png

# Editor / OS
.DS_Store
*.swp

# Generated test media and scratch output. Agents synthesise clips, tones and
# speech with ffmpeg/espeak to exercise their pipelines; none of it is source.
# demo.mp4 is deliberately not matched — those are the deliverables.
*.wav
*.pcm
*.raw
apps/*/fixtures/
apps/*/test-media/
# Synthetic source clips an app keeps beside itself to edit or play.
# Only the video files: fixtures like sample.srt are the interface
# between two apps and must stay.
apps/*/media/*.mp4
apps/*/out/
apps/*/tmp/

# Model weights, should any ever land here. They belong on disk, not in git.
*.gguf
*.safetensors
*.onnx

# Python bytecode from the table/corpus generators under tools/
__pycache__/
*.pyc
.vercel

# Agent worktrees (see TODO.md: toolkit work happens in one).
.claude/worktrees/

# Distribution build trees and images: downloaded sources, compiled kernels,
# packages, root filesystems. All reproducible from distro/.
distro/build/
distro/out/
