",{"class":"sk-140thh"}," = $mod,       Prior,  workspacerel -1"]],"\n",["span",{"class":"line"},["span",{"class":"sk-1itgoe"},"bind"],["span",{"class":"sk-140thh"}," = $mod,       Next,   workspacerel +1"]],"\n",["span",{"class":"line"}],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"# The compositor. Session actions are intent-only nested: logged, not run."]],"\n",["span",{"class":"line"},["span",{"class":"sk-1itgoe"},"bind"],["span",{"class":"sk-140thh"}," = $mod SHIFT, R,      reload"]],"\n",["span",{"class":"line"},["span",{"class":"sk-1itgoe"},"bind"],["span",{"class":"sk-140thh"}," = $mod CTRL SHIFT, D, debughud"]],"\n",["span",{"class":"line"},["span",{"class":"sk-1itgoe"},"bind"],["span",{"class":"sk-140thh"}," = $mod SHIFT, E,      exit"]],"\n",["span",{"class":"line"},["span",{"class":"sk-1itgoe"},"bind"],["span",{"class":"sk-140thh"}," = $mod ALT,   Q,      quit"]],"\n",["span",{"class":"line"}],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"# The bare function-key twins the scripted demo recorder needs live in"]],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"# apps/wm/demo.conf now (record.sh passes it with --config=)."]],"\n",["span",{"class":"line"}],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"# Per-application rules. Matched once, when the window maps."]],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"#   rule = app_id=palmy-term, float"]],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"#   rule = title~Volume Control, float, noborder"]],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"#   rule = app_id=pixels, workspace 3"]],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"#   rule = app_id=gallery, size 900x600"]],"\n",["span",{"class":"line"}],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"# Outputs. One line per head; the name is matched against the connector."]],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"#   output = eDP-1,  1920x1080+0+0,    scale=1"]],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"#   output = DP-2,   2560x1440+1920+0, scale=1, workspaces=6-9"]],"\n",["span",{"class":"line"}],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"# Autostart. Empty on purpose: a fresh install must not run anything you did"]],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"# not ask for. One command per line, resolved against $PATH."]],"\n",["span",{"class":"line"},["span",{"class":"sk-21nrsd"},"#   exec = waybar"]]]],"\n",["h2",{"id":"on-palmframe"},"On Palmframe"],"\n",["p",0,"The keyboard layout comes from ",["code",0,"/etc/palm/keyboard"]," (",["code",0,"layout = fr"],", for example), which the installer writes and wm reloads when it changes. The bar's clock follows ",["code",0,"/etc/localtime"],"."],"\n",["p",0,"On bare metal it has no VT switching, it ignores keyboards and mice plugged in after it starts, it has only ever run one monitor, and it repaints the whole screen on the CPU every frame. Clients see keys as press and release pairs, so none can see a key held down. There is no ",["code",0,"linux-dmabuf"],", so no GPU client, and no XWayland. The full list is in ",["a",{"href":"/distro/missing"},"What is missing"]," and in the ",["a",{"href":"/distro/roadmap#the-window-manager"},"roadmap"],"; the bare-metal backend's own notes are ",["a",{"href":"/distro/notes-wm"},"wm on bare metal"],"."]]}