code",0,"message_text"]," fills it in English. ",["code",0,"Progress.detail"]," is the\nprogress line as a ",["code",0,"Message"]," (",["code",0,"Progress.message"]," stays its English text).\nThe GUI translates both. Besides the rules above, it refuses read-only\ndisks, disks with a mounted filesystem, disks it cannot find and a swap\nfile that would leave less than 4 GiB."],"\n",["li",0,["code",0,"keyboard_settings(k)"]," is the body of ",["code",0,"/etc/palm/keyboard"]," for a choice.\nA layout with no Latin letters (",["code",0,"keyboard_needs_latin"],": ara, ru, gr, ...)\nbecomes ",["code",0,"layout = us,<layout>"],", ",["code",0,"variant = ,<variant>"],", ",["code",0,"options = grp:alt_shift_toggle"],", so a user name can be typed."],"\n",["li",0,["code",0,"Zone.country"]," is the country's name (",["code",0,"France"],"), from ",["code",0,"iso3166.tab"],", and\n",["code",0,"Zone.country_code"]," its code. ",["code",0,"list_zones"]," includes ",["code",0,"UTC"],"."],"\n",["li",0,"Language codes are ",["code",0,"en_US"],", ",["code",0,"fr_FR"],", ",["code",0,"de_DE"],", ",["code",0,"es_ES"],", ",["code",0,"ar"]," and ",["code",0,"ja_JP"],".\nAny other catalogue directory under ",["code",0,"locale_root"]," is offered by its code."],"\n",["li",0,["code",0,"Plan.packages"]," empty means ",["code",0,"{\"palmframe\"}"],". The GUI passes\n",["code",0,"{\"palmframe\", \"fonts-cjk\"}"]," for Japanese."],"\n"],"\n",["p",0,"Additions, all optional for a front end:"],"\n",["table",0,"\n",["thead",0,"\n",["tr",0,"\n",["th",0,"name"],"\n",["th",0,"what"],"\n"],"\n"],"\n",["tbody",0,"\n",["tr",0,"\n",["td",0,["code",0,"default_plan() -> Plan"]],"\n",["td",0,"en_US, us, UTC, hostname palmframe, the medium's repository, ",["code",0,"efi_boot_entry"]," if ",["code",0,"/sys/firmware/efi"]," exists"],"\n"],"\n",["tr",0,"\n",["td",0,["code",0,"Options"],", ",["code",0,"default_options()"]],"\n",["td",0,"target directory (default ",["code",0,"/mnt/target"],"), ",["code",0,"disk_image"]," (the disk is a plain file; refused for ",["code",0,"/dev/*"],"), a subset of ",["code",0,"steps"],", palm binary, keys dir, limine dir, efivars dir, log path, ",["code",0,"dry_run"],", ",["code",0,"on_log"]," (each log line, used for the GUI's log view and the CLI's ",["code",0,"--verbose"],")"],"\n"],"\n",["tr",0,"\n",["td",0,["code",0,"install_with(p, o, report, user)"]],"\n",["td",0,["code",0,"install"]," is ",["code",0,"install_with(p, default_options(), ...)"]],"\n"],"\n",["tr",0,"\n",["td",0,["code",0,"validate_with(p, o, disks)"]],"\n",["td",0,"validate against a given disk list, or for a disk image"],"\n"],"\n",["tr",0,"\n",["td",0,["code",0,"step_title(Step)"],", ",["code",0,"step_name(Step)"]],"\n",["td",0,"\"Installing packages\" and \"packages\""],"\n"],"\n"],"\n"],"\n",["p",0,"What ",["code",0,"install"]," does, in order:"],"\n",["ol",0,"\n",["li",0,["strong",0,"Partition."]," The core writes a fresh GPT itself: a protective MBR, the\nprimary and backup headers, and CRC32s. Partition 1 is the ESP (type\nC12A7328-F81F-11D2-BA4B-00A0C93EC93B, 512 MiB, aligned to 1 MiB).\nPartition 2 is the Linux root (0FC63DAF-8483-4772-8E79-3D69D8477DE4,\nthe rest of the disk). Then ",["code",0,"BLKRRPART"],", and a wait for the partition\nnodes.\n",["em",0,"Built:"]," the table has 128 entries, and GUIDs are version 4 from\ngetrandom. Partition 3 is a BIOS boot partition\n(21686148-6449-6E6F-744E-656564454649) in the gap from the first usable\nLBA to 1 MiB. The old table is read first, to know which UEFI entry\npointed at this disk. The first and last MiB are zeroed first. 4 KiB\nlogical sectors are honoured. Both copies of the table are read back and\nCRC-checked before formatting. ",["code",0,"BLKRRPART"]," is retried on EBUSY."],"\n",["li",0,["strong",0,"Format."]," ",["code",0,"mkfs.fat -F 32 -n PALMEFI"]," and ",["code",0,"mkfs.ext4 -F -L palmroot"],".\nThese come from dosfstools and e2fsprogs, shipped in the live image as\npackages. busybox keeps the ",["code",0,"mke2fs"]," and ",["code",0,"mkfs.vfat"]," names."],"\n",["li",0,["strong",0,"Mount."]," The root goes at ",["code",0,"/mnt/target"]," and the ESP at\n",["code",0,"/mnt/target/boot/efi"],"."],"\n",["li",0,["strong",0,"Packages."]," ",["code",0,"palm --root /mnt/target --initdb --repo <repo> --keys-dir /etc/palm/keys --yes add palmframe <extra>"],".\n",["em",0,"Built:"]," palm's ",["code",0,"--json"]," is a single document printed at the end, so\nprogress comes from palm's text output instead: the plan lines give the\ntotal and the ",["code",0,"installing <pkg>"]," lines give progress. ",["code",0,"file://"]," is\nstripped from the repository, because palm takes a path. 33 packages\nare installed; ",["code",0,"palmframe-demo"]," (the disk image's ",["code",0,"/home/palm"],") is not\namong them."],"\n",["li",0,["strong",0,"Configure."]," The core writes:","\n",["ul",0,"\n",["li",0,["code",0,"/etc/hostname"]," and ",["code",0,"/etc/hosts"],"."],"\n",["li",0,"The users in passwd, group and shadow. The ",["code",0,"palm"]," demo user is removed\nfrom every file and member list. The new user gets uid/gid 1000 (or the\nnext free number), wheel, video, input and audio, ",["code",0,"/bin/sh"],", and a home\ncopied from ",["code",0,"/etc/skel"]," with mode 0700. Hashes are ",["code",0,"$6$"]," with a random\n16-character salt."],"\n",["li",0,["code",0,"/etc/locale.conf"],", for example ",["code",0,"LANG=fr_FR.UTF-8"],"."],"\n",["li",0,["code",0,"/etc/palm/keyboard"]," (see below)."],"\n",["li",0,"The ",["code",0,"/etc/localtime"]," → ",["code",0,"../usr/share/zoneinfo/<zone>"]," symlink, and\n",["code",0,"/etc/timezone"],"."],"\n",["li",0,["code",0,"/etc/fstab"],", naming the root and the ESP at ",["code",0,"/boot/efi"]," by PARTUUID."],"\n",["li",0,["code",0,"/etc/palm/repositories"],", pointing at the network repository.\n",["em",0,"Built:"]," ",["code",0,"repositories"]," is rewritten only when the install came from an\n",["code",0,"http(s)://"]," repository. An install from the medium keeps\npalmframe-base's network repository."],"\n"],"\n"],"\n",["li",0,["strong",0,"Bootloader."]," limine's ",["code",0,"BOOTX64.EFI"]," goes at ",["code",0,"EFI/BOOT/BOOTX64.EFI"],"\n",["em",0,"and"]," at ",["code",0,"EFI/palmframe/BOOTX64.EFI"],". A ",["code",0,"limine.conf"]," boots ",["code",0,"/vmlinuz"],",\ncopied onto the ESP, with ",["code",0,"root=PARTUUID=<root> rw"],". If ",["code",0,"efi_boot_entry"],"\nis set, a ",["code",0,"Boot####"]," variable named \"Palmframe\" points at\n",["code",0,"\\EFI\\palmframe\\BOOTX64.EFI"],", and ",["code",0,"BootOrder"]," is updated. Both are written\nthrough efivarfs (",["code",0,"/sys/firmware/efi/efivars"],", attributes NV|BS|RT, with\nthe immutable flag cleared through FS_IOC_SETFLAGS).\n",["em",0,"Built:"],"\n",["ul",0,"\n",["li",0,["code",0,"limine.conf"]," is at ",["code",0,"boot/limine/limine.conf"],", where both binaries find\nit. It has two entries: the normal boot, and a single-user root shell\n(",["code",0,"palm.single"],")."],"\n",["li",0,["code",0,"BOOTX64.EFI"]," comes from the target's ",["code",0,"/usr/share/limine"]," if present,\nand otherwise from the live system's."],"\n",["li",0,"The device path is the short form ",["code",0,"HD(1,GPT,<esp guid>,start,size)/\\EFI\\palmframe\\BOOTX64.EFI"],"."],"\n",["li",0,"The description is \"Palmframe (","<host name>",")\", or \"Palmframe\" for the\ndefault host name. An existing entry is reused only when it is ours\nand points at the new ESP or at a partition of the erased table;\notherwise the lowest free number is taken, so each disk keeps its own\nentry. The entry is then put first in ",["code",0,"BootOrder"],"."],"\n",["li",0,"palm-init does not mount efivarfs, so the core mounts it for the write\nand unmounts it afterwards."],"\n",["li",0,"A failed write is logged but does not fail the install, because the\ndisk still boots through ",["code",0,"EFI/BOOT/BOOTX64.EFI"],"."],"\n",["li",0,["code",0,"limine-bios.sys"]," is copied to ",["code",0,"boot/limine/"]," on the ESP and ",["code",0,"limine bios-install <disk> 3"]," puts limine's stage 1 into the MBR and stage 2\ninto the BIOS boot partition. The tool is ",["code",0,"/usr/lib/palm-install/limine"],"\n(palm-install's package) unless ",["code",0,"limine"]," is in PATH. A failure is fatal\nonly when the machine booted through a BIOS."],"\n",["li",0,["code",0,"Plan.swap_bytes"]," makes ",["code",0,"/swapfile"]," (configure step) and its fstab line."],"\n"],"\n"],"\n",["li",0,["strong",0,"Unmount"],", then sync."],"\n"],"\n",["h2",{"id":"palm-install"},"palm-install"],"\n",["p",0,["code",0,"palm-install --help"]," lists every option: ",["code",0,"--disk"],", ",["code",0,"--language"],",\n",["code",0,"--keyboard layout[:variant]"],", ",["code",0,"--timezone"],", ",["code",0,"--hostname"],", ",["code",0,"--user"],",\n",["code",0,"--full-name"],", ",["code",0,"--password-file <file|->"],", ",["code",0,"--root-password-file"],", ",["code",0,"--repo"],",\n",["code",0,"--package"]," (repeatable), ",["code",0,"--swap <size>"],", ",["code",0,"--no-efi-entry"],",\n",["code",0,"--no-bios-boot"],", ",["code",0,"--answers <file>"],", ",["code",0,"--yes"],", ",["code",0,"--dry-run"],", ",["code",0,"--json"],",\n",["code",0,"--verbose"],", and ",["code",0,"--list-disks|layouts|zones|languages"],". ",["em",0,"Built:"]," with no\noptions on a terminal, or ",["code",0,"--interactive"],", it asks each question instead."],"\n",["p",0,"Passwords are never accepted as command-line arguments, because\n",["code",0,"/proc/<pid>/cmdline"]," is world-readable. ",["code",0,"password ="]," is allowed in an\nanswers file, and command-line options override the answers file.\n",["code",0,"palm-install"]," refuses without ",["code",0,"--yes"],". Exit codes follow palm's: 0, 2\nusage, 3 not found, 4 refused (invalid plan, no ",["code",0,"--yes"],", not root), 7\nfailed. ",["code",0,"--json"]," prints one ",["code",0,"{\"event\":\"progress\"|\"log\"|\"invalid\"|\"done\",...}"],"\nobject per line."],"\n",["p",0,"The build-host test paths are ",["code",0,"--disk-image <file>"]," (implies no mounting),\n",["code",0,"--target <dir>"],", ",["code",0,"--steps a,b,..."],", ",["code",0,"--efivars <dir>"]," (a directory standing\nin for efivarfs), ",["code",0,"--palm"],", ",["code",0,"--keys-dir"],", ",["code",0,"--limine-dir"],", ",["code",0,"--log"]," and\n",["code",0,"--selftest"],". A disk image never uses the host's efivarfs."],"\n",["h2",{"id":"system-configuration-files-the-installed-system-honours"},"System configuration files the installed system honours"],"\n",["ul",0,"\n",["li",0,["strong",0,["code",0,"/etc/palm/keyboard"]],": ",["code",0,"layout = fr"],", ",["code",0,"variant ="],", ",["code",0,"options ="],", and\noptionally ",["code",0,"model ="],", as ",["code",0,"key = value"]," lines. The wm (",["code",0,"--drm"],") compiles\nthat keymap from ",["code",0,"/usr/share/X11/xkb"]," with its own XKB compiler at start.\nIt re-reads the file on SIGHUP, at once through inotify on the directory,\nand through a 1 s stat check. Each reload sends the new keymap to every\nclient. The live installer relies on this to switch layout as the user\npicks it; the GUI signals only a process whose ",["code",0,"comm"]," is ",["code",0,"wm"],".\n",["code",0,"XKB_DEFAULT_LAYOUT"]," and ",["code",0,"XKB_DEFAULT_VARIANT"]," override the file. A layout\nthat cannot be compiled falls back to ",["code",0,"us"],", and the reason is logged.\nSeveral layouts (",["code",0,"us,ru"]," with ",["code",0,"grp:alt_shift_toggle"],") work."],"\n",["li",0,["strong",0,["code",0,"/etc/locale.conf"]],": ",["code",0,"LANG=fr_FR.UTF-8"],". palm-login exports ",["code",0,"LANG"],", and\n",["code",0,"LANGUAGE"]," and ",["code",0,"LC_*"]," when set, to the greeter and to user sessions.\npalm-init exports them to services, re-reading the file before each start.\nOnly those keys are taken from the file. ",["code",0,"kit.i18n"]," reads ",["code",0,"LANGUAGE"],", then\n",["code",0,"LC_ALL"],"