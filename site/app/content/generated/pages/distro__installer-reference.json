bool"]]]],"\n",["p",0,["em",0,"Built:"]," the library also has ",["code",0,"trnf"],", ",["code",0,"i18n_language"],", ",["code",0,"i18n_shutdown"],",\n",["code",0,"i18n_parse"],", ",["code",0,"i18n_load_file"],", ",["code",0,"i18n_lookup"]," and ",["code",0,"i18n_catalog_destroy"],"."],"\n",["ul",0,"\n",["li",0,"The fallback is ",["code",0,"fr_FR.UTF-8@euro"]," → ",["code",0,"fr_FR.UTF-8"]," → ",["code",0,"fr_FR@euro"]," →\n",["code",0,"fr_FR"]," → ",["code",0,"fr"]," → msgid. Every catalogue found along the way is kept, so a\nstring missing from ",["code",0,"fr_FR"]," is looked up in ",["code",0,"fr"],"."],"\n",["li",0,"The root is ",["code",0,"/usr/share/palm/locale"],". ",["code",0,"PALM_LOCALE_DIR"]," overrides it."],"\n",["li",0,"Odin's explicit argument indices (",["code",0,"%[0]s"],") start at 0. Translations use\nthem to reorder arguments."],"\n",["li",0,["code",0,"apps/kit/i18n_test"]," tests the library and lints every\n",["code",0,"distro/locale/*/*.msg"],"."],"\n"],"\n",["p",0,"Catalogue format (",["code",0,".msg"],"): UTF-8, gettext-like but simpler. Lines of the form\n",["code",0,"msgid = translation"]," would break on an ",["code",0,"="]," in the text, so the format does\nnot use them:"],"\n",["pre",{"class":["shiki","shiki-themes","github-light","github-dark","sk-25qmca"],"tabindex":"0","data-lang":"text"},["code",0,["span",{"class":"line"},["span",{"class":"sk-wvjl67"},"# comment"]],"\n",["span",{"class":"line"},["span",{"class":"sk-wvjl67"},"plural = n > 1"]],"\n",["span",{"class":"line"},["span",{"class":"sk-wvjl67"},""]],"\n",["span",{"class":"line"},["span",{"class":"sk-wvjl67"},"msgid \"Install Palmframe\""]],"\n",["span",{"class":"line"},["span",{"class":"sk-wvjl67"},"msgstr \"Installer Palmframe\""]],"\n",["span",{"class":"line"},["span",{"class":"sk-wvjl67"},""]],"\n",["span",{"class":"line"},["span",{"class":"sk-wvjl67"},"msgid \"%d package\""]],"\n",["span",{"class":"line"},["span",{"class":"sk-wvjl67"},"msgid_plural \"%d packages\""]],"\n",["span",{"class":"line"},["span",{"class":"sk-wvjl67"},"msgstr[0] \"%d paquet\""]],"\n",["span",{"class":"line"},["span",{"class":"sk-wvjl67"},"msgstr[1] \"%d paquets\""]]]],"\n",["p",0,"The header has ",["code",0,"key = value"]," lines. ",["code",0,"plural"]," takes a full gettext C\nexpression. ",["code",0,"language"],", ",["code",0,"name"]," and ",["code",0,"english"]," name the catalogue's language,\nand ",["code",0,"direction = rtl|ltr"]," overrides the default, which is right to left for\nar, he, fa and ur. Arabic uses its real six-form rule, and Japanese uses\n",["code",0,"plural = 0"],". An empty ",["code",0,"msgstr"]," means untranslated. ",["code",0,"distro/locale/README.md"],"\nis the translators' guide."],"\n",["h2",{"id":"live-image-distrolive"},"Live image (",["code",0,"distro/live/"],")"],"\n",["ul",0,"\n",["li",0,"The root filesystem is assembled with ",["code",0,"palm --root ... --initdb add palmframe-live"]," under fakeroot, from the same signed repository.\n",["em",0,"Built:"]," ",["code",0,"palmframe-live"]," depends on the base system, the kiosk wm,\n",["code",0,"term"],", ",["code",0,"palm-install"],", ",["code",0,"installer"],", ",["code",0,"e2fsprogs"],", ",["code",0,"dosfstools"],", ",["code",0,"limine"],",\n",["code",0,"tzdata"],", ",["code",0,"xkeyboard-config"]," and ",["code",0,"palm-locale"],", 19 packages in all, and\ncarries a 100 KB Japanese subset of Noto Sans CJK instead of ",["code",0,"fonts-cjk"],".\nThe packages of ",["code",0,"palmframe"]," and ",["code",0,"fonts-cjk"]," with their dependencies (36)\nare copied flat to ",["code",0,"/usr/share/palm/repo"]," with a newly signed index, so\ninstalling needs no network."],"\n",["li",0,["code",0,"palmframe-live"]," provides:","\n",["ul",0,"\n",["li",0,"the ",["code",0,"installer"]," service, running ",["code",0,"/usr/lib/palm-live/installer-session"],"\nas root, which runs ",["code",0,"wm --drm --kiosk --exec installer"],". The kernel\noption ",["code",0,"palm.live.serial"]," starts no session, and ",["code",0,"palm.live.exec=<cmd>"],"\nruns another program instead."],"\n",["li",0,"a root autologin getty on ttyS0 (",["code",0,"getty-live"],")."],"\n",["li",0,"the ",["code",0,"/etc/palm/live"]," marker and the ",["code",0,"/init"]," symlink to palm-init."],"\n",["li",0,["code",0,"/etc/palm/services.off/palm-login"]," and ",["code",0,"getty-ttyS0"],", which mask\npalmframe-base's services."],"\n"],"\n"],"\n",["li",0,["code",0,"/boot/vmlinuz"]," is left out of the initramfs to save RAM, because the\nkernel is on the ISO beside it. ",["code",0,"palm verify"]," on the live system reports\nexactly that one file as missing."],"\n",["li",0,"The root is packed as a zstd cpio initramfs (",["code",0,"CONFIG_RD_ZSTD=y"],"), booted by\nlimine from an ISO 9660 image built with ",["code",0,"xorriso"],": UEFI El Torito with\n",["code",0,"limine-uefi-cd.bin"],", BIOS with ",["code",0,"limine-bios-cd.bin"],", then ",["code",0,"limine bios-install"]," for hybrid USB boot. The limine menu has two entries,\n",["em",0,"Install Palmframe"]," and ",["em",0,"Install Palmframe (serial console only)"],"."],"\n",["li",0,"The output is ",["code",0,"distro/out/palmframe-live.iso"],", built by ",["code",0,"make -C distro iso"],":\nabout 74 MB, with a 57 MB initramfs that unpacks to about 81 MiB.\n",["code",0,"distro/run-qemu.sh --iso [--disk <target.qcow2>]"]," boots it with a target\ndisk attached as virtio. Without ",["code",0,"--disk"],", it makes\n",["code",0,"distro/out/target.qcow2"]," (8 GiB) if the file is missing. OVMF's variable\nstore is kept as ",["code",0,"<disk>.OVMF_VARS.fd"]," beside the disk."],"\n"]]}